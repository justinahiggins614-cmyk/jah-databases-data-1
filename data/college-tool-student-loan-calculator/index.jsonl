{"id": "JAH-CTOOL-STUDENTL-000004", "slug": "college-tool-student-loan-calculator", "title": "Student Loan Calculator \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. $27,000 at 5.5% over 10 years: $293/month, $8,160 total interest; +$50/month extra saves $1,940 and 1.8 years.", "capabilities": ["Compute monthly payment per plan", "Show total interest over the loan life", "Calculate the payoff date", "Model extra payments' effect", "Compare plans side by side"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const P=27000,annual=0.055,n=120;const r=annual/12;const M=P*r/(1-Math.pow(1+r,-n));const total=M*n;const interest=total-P;J({monthly:+M.toFixed(2),totalInterest:+interest.toFixed(0)});assert(M>290&&M<296&&interest>8000,'loan');", "verified_output": "{\"monthly\":293.02,\"totalInterest\":8163}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-college-student-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Student Loan Calculator Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Financial Aid Organizer", "Student Budget Planner", "Expense Tracker"], "sibling_edition": "college-tool-student-loan-calculator-signature"}}
