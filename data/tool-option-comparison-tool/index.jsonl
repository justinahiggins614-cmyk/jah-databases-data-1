{"id": "JAH-TOOL-OPTIONCO-000002", "slug": "tool-option-comparison-tool", "title": "Option Comparison Tool \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Options, criteria with weights, evidence per cell. Outputs: Ranked options with scores, winner, and sensitivity analysis.", "capabilities": ["Weighted multi-criteria scoring matrix", "Per-criterion evidence notes", "Sensitivity analysis on weights", "Pairwise comparison mode", "Tie and near-tie reporting"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const task={goal:'publish report',constraints:['by Friday'],done:'PDF delivered'};const ok=task.goal&&task.done;J({valid:!!ok});assert(ok,'contract');", "verified_output": "{\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Option Comparison Tool Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Decision Support Engine", "Mathematical Reasoning Tool", "Report Generator"], "sibling_edition": "tool-option-comparison-tool-signature"}}
{"id": "JAH-TOOL-OPTIONCO-000003", "slug": "tool-option-comparison-tool", "title": "Option Comparison Tool \u2014 Core capabilities", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 5, "body": "Public edition. Public tool knowledge, fact-checked reference. Capabilities: Weighted multi-criteria scoring matrix; Per-criterion evidence notes; Sensitivity analysis on weights; Pairwise comparison mode; Tie and near-tie reporting.", "capabilities": ["Weighted multi-criteria scoring matrix", "Per-criterion evidence notes", "Sensitivity analysis on weights", "Pairwise comparison mode", "Tie and near-tie reporting"], "demo": {"language": "javascript", "title": "Core operation executed", "code": "const steps=[{id:'a',deps:[]},{id:'b',deps:['a']},{id:'c',deps:['a']},{id:'d',deps:['b','c']}];const done=new Set(),order=[];while(order.length<steps.length){const nxt=steps.find(s=>!done.has(s.id)&&s.deps.every(d=>done.has(d)));if(!nxt)throw new Error('cycle');done.add(nxt.id);order.push(nxt.id);}J({order});assert(order[0]==='a'&&order[3]==='d','topo');", "verified_output": "{\"order\":[\"a\",\"b\",\"c\",\"d\"]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Option Comparison Tool Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Decision Support Engine", "Mathematical Reasoning Tool", "Report Generator"], "sibling_edition": "tool-option-comparison-tool-signature"}}
{"id": "JAH-TOOL-OPTIONCO-000004", "slug": "tool-option-comparison-tool", "title": "Option Comparison Tool \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Compare 3 laptops on price, battery, and weight with weights 0.4/0.4/0.2: rank them and show how the winner changes if battery weight drops.", "capabilities": ["Weighted multi-criteria scoring matrix", "Per-criterion evidence notes", "Sensitivity analysis on weights", "Pairwise comparison mode", "Tie and near-tie reporting"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "function solveQuad(a,b,c){const d=b*b-4*a*c;if(d<0)return[];const s=Math.sqrt(d);return [(-b-s)/(2*a),(-b+s)/(2*a)];}const roots=solveQuad(3,-5,-2);const check=roots.map(r=>3*r*r-5*r-2);J({roots:roots.map(r=>+r.toFixed(4)),residuals:check.map(x=>+x.toExponential(1))});assert(Math.abs(check[0])<1e-9&&Math.abs(check[1])<1e-9,'verify');", "verified_output": "{\"roots\":[-0.3333,2],\"residuals\":[-2.2e-16,0]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Option Comparison Tool Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Decision Support Engine", "Mathematical Reasoning Tool", "Report Generator"], "sibling_edition": "tool-option-comparison-tool-signature"}}
{"id": "JAH-TOOL-OPTIONCO-000005", "slug": "tool-option-comparison-tool", "title": "Option Comparison Tool \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Scores are only as honest as the input evidence; it refuses to compare on criteria with no data.", "capabilities": ["Weighted multi-criteria scoring matrix", "Per-criterion evidence notes", "Sensitivity analysis on weights", "Pairwise comparison mode", "Tie and near-tie reporting"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "function checkLogic(premises,conclusion){const rainWet=premises.includes('rain->wet');if(conclusion==='rained'&&premises.includes('wet')&&!premises.includes('rain'))return {valid:false,fallacy:'affirming the consequent'};return {valid:true};}const r=checkLogic(['rain->wet','wet'],'rained');J(r);assert(r.valid===false&&r.fallacy,'logic');", "verified_output": "{\"valid\":false,\"fallacy\":\"affirming the consequent\"}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Option Comparison Tool Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Decision Support Engine", "Mathematical Reasoning Tool", "Report Generator"], "sibling_edition": "tool-option-comparison-tool-signature"}}
