{"id": "JAH-SIG-MISSIONL-000004", "slug": "tool-mission-level-verification-engine-signature", "title": "Mission-Level Verification Engine \u2014 Worked example", "edition": "signature", "src": "signature-generated-completion", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Signature edition. Original Signature methods and framings developed for the JAH system, labeled Signature throughout. Verify a 3-objective survey mission: 2 objectives verified with evidence, 1 partial at 60% \u2014 reported exactly so.", "capabilities": ["Objective-to-criteria mapping", "Evidence checking per criterion", "Per-objective verified/not-verified verdicts", "Partial-success quantification", "Full evidence citation"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const claims=[{c:'motor ok',ev:5},{c:'sensor ok',ev:2},{c:'link ok',ev:0}];const conf=claims.map(x=>({claim:x.c,conf:x.ev>=4?'high':x.ev>=2?'medium':'insufficient - do not decide'}));J({conf});assert(conf[2].conf.includes('insufficient'),'uncertainty');", "verified_output": "{\"conf\":[{\"claim\":\"motor ok\",\"conf\":\"high\"},{\"claim\":\"sensor ok\",\"conf\":\"medium\"},{\"claim\":\"link ok\",\"conf\":\"insufficient - do not decide\"}]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Mission-Level Verification Engine Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Result Verification Engine", "Dynamic Strategy Engine", "Reprod