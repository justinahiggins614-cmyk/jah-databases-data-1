{"id": "JAH-SIG-MISSIONL-000005", "slug": "tool-mission-level-verification-engine-signature", "title": "Mission-Level Verification Engine \u2014 Safety, limits, and failure modes", "edition": "signature", "src": "signature-generated-completion", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Signature edition. Original Signature methods and framings developed for the JAH system, labeled Signature throughout. Cannot verify objectives that were never made measurable; it reports unmeasurable objectives as unverifiable. Capability specification and design target: this database describes what the tool must do, not a claim of implementation or deployment. Defensive and engineering content only \u2014 no weapon-targeting or attack-execution content.", "capabilities": ["Objective-to-criteria mapping", "Evidence checking per criterion", "Per-objective verified/not-verified verdicts", "Partial-success quantification", "Full evidence citation"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const AUTH={changeGoal:false};function revise(change){if(change.touchesGoal&&!AUTH.changeGoal)return {refused:'goal change needs approval'};return {ok:true};}J(revise({touchesGoal:true}));assert(revise({touchesGoal:true}).refused,'govern');", "verified_output": "{\"refused\":\"goal change needs approval\"}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Mission-Level Verification Engine Librarian", "scope": "archive-aware", "assistant