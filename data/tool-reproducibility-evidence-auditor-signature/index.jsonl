{"id": "JAH-SIG-REPRODUC-000002", "slug": "tool-reproducibility-evidence-auditor-signature", "title": "Reproducibility and Evidence Auditor \u2014 Input and output contract", "edition": "signature", "src": "signature-generated-completion", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Signature edition. Original Signature methods and framings developed for the JAH system, labeled Signature throughout. Inputs: Experiment record: data, params, versions, steps, results. Outputs: Reproducibility package with completeness grade.", "capabilities": ["Input-data checksum capture", "Parameter and version logging", "Procedure-step recording", "Result-to-input traceability", "Reproducibility grading"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const exp={data:'s.csv',params:{n:100},version:'1.2.0'};const ok=exp.data&&exp.params&&exp.version;J({valid:!!ok});assert(ok,'contract');", "verified_output": "{\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Reproducibility and Evidence Auditor Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Mission-Level Verification Engine", "Experiment Design Optimizer", "Audit Logger"], "sibling_edition": "tool-reproducibility-evidence-auditor"}}
{"id": "JAH-SIG-REPRODUC-000003", "slug": "tool-reproducibility-evidence-auditor-signature", "title": "Reproducibility and Evidence Auditor \u2014 Core capabilities", "edition": "signature", "src": "signature-generated-completion", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 5, "body": "Signature edition. Original Signature methods and framings developed for the JAH system, labeled Signature throughout. Capabilities: Input-data checksum capture; Parameter and version logging; Procedure-step recording; Result-to-input traceability; Reproducibility grading.", "capabilities": ["Input-data checksum capture", "Parameter and version logging", "Procedure-step recording", "Result-to-input traceability", "Reproducibility grading"], "demo": {"language": "javascript", "title": "Core operation executed", "code": "const xs=[10,11,9,10,12,10,11,45,10,9];const mean=xs.reduce((a,b)=>a+b)/xs.length;const sd=Math.sqrt(xs.reduce((a,b)=>a+(b-mean)**2,0)/xs.length);const flags=xs.map((x,i)=>({i,z:+((x-mean)/sd).toFixed(1)})).filter(o=>Math.abs(o.z)>2.5);J({mean:+mean.toFixed(1),flags});assert(flags.length===1&&flags[0].i===7,'anomaly');", "verified_output": "{\"mean\":13.7,\"flags\":[{\"i\":7,\"z\":3}]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Reproducibility and Evidence Auditor Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Mission-Level Verification Engine", "Experiment Design Optimizer", "Audit Logger"], "sibling_edition"