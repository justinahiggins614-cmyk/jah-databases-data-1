{"id": "JAH-GRILL-000001", "slug": "grills-smokers-public", "title": "Charcoal Grills", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "grill and smoker record", "ladder_rank": 1, "body": "Charcoal grills burn lump charcoal or briquettes for high heat and smoky flavor. Lump charcoal lights fast and burns hot; briquettes burn longer and more evenly. Use a chimney starter — never lighter fluid, which taints food. Control heat with the vents: more air means hotter fire. Bank coals to one side for two-zone cooking: sear over coals, finish on the cool side.", "capabilities": ["Compare lump charcoal and briquettes", "Explain chimney starters", "Explain vent heat control", "Describe two-zone cooking", "Explain the no-lighter-fluid rule"], "demo": {"language": "javascript", "title": "Vent heat model", "code": "const vent=0.75;J({heat_pct:vent*100});assert(vent*100===75,'charcoal');", "verified_output": "{\"heat_pct\":75}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Grills Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Gas Grills", "Pellet Grills", "Kamado Cookers"], "sibling_edition": "grills-smokers-public-signature"}}
{"id": "JAH-GRILL-000002", "slug": "grills-smokers-public", "title": "Gas Grills", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "grill and smoker record", "ladder_rank": 2, "body": "Gas grills light instantly and hold steady temperatures with knob control. Propane tanks or natural-gas lines fuel them; check connections for leaks with soapy water. Preheat 10 to 15 minutes with the lid closed. Flavorizer bars vaporize drippings for grilled flavor. Keep a spare tank — running out mid-cook is the classic gas-grill failure.", "capabilities": ["Explain gas-grill convenience", "Describe leak testing with soapy water", "Explain preheating procedure", "Explain flavorizer bars", "Explain the spare-tank rule"], "demo": {"language": "javascript", "title": "Preheat time", "code": "const preheat=12;J({minutes:preheat});assert(preheat>=10&&preheat<=15,'gaspreheat');", "verified_output": "{\"minutes\":12}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Grills Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Charcoal Grills", "Pellet Grills", "Kamado Cookers"], "sibling_edition": "grills-smokers-public-signature"}}
{"id": "JAH-GRILL-000003", "slug": "grills-smokers-public", "title": "Pellet Grills", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "grill and smoker record", "ladder_rank": 3, "body": "Pellet grills burn compressed wood pellets, feeding them automatically from a hopper. A digital controller holds temperature within about 10 degrees — set-and-forget smoking. Different pellet woods (hickory, apple, mesquite) add different smoke flavors. They grill, smoke, bake, and roast in one unit. Keep pellets dry; wet pellets jam the auger.", "capabilities": ["Explain pellet-feed automation", "Describe temperature controllers", "List pellet wood flavors", "Explain multi-function cooking", "Explain dry-pellet storage"], "demo": {"language": "javascript", "title": "Hopper runtime", "code": "const hopper=20,rate=1.5;J({hours:+(hopper/rate).toFixed(1)});assert(hopper/rate>10,'pellets');", "verified_output": "{\"hours\":13.3}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Grills Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Charcoal Grills", "Gas Grills", "Kamado Cookers"], "sibling_edition": "grills-smokers-public-signature"}}
{"id": "JAH-GRILL-000004", "slug": "grills-smokers-public", "title": "Kamado Cookers", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "grill and smoker record", "ladder_rank": 4, "body": "Kamado cookers are egg-shaped ceramic grills with superb heat retention. The thick ceramic walls hold low-and-slow temperatures for 12+ hours on one load of charcoal. They also sear at 700+ degrees with the vents wide open. A heat deflector turns the kamado into an outdoor oven for pizza and bread. Burp the lid — open it an inch first — to avoid a flashback of flame.", "capabilities": ["Explain kamado ceramic construction", "Describe low-and-slow endurance", "Explain high-heat searing", "Describe the heat-deflector oven mode", "Explain lid-burping safety"], "demo": {"language": "javascript", "title": "Temp range", "code": "const low=225,high=750;J({range:high-low});assert(high-low===525,'kamado');", "verified_output": "{\"range\":525}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Grills Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Charcoal Grills", "Gas Grills", "Pellet Grills"], "sibling_edition": "grills-smokers-public-signature"}}
{"id": "JAH-GRILL-000005", "slug": "grills-smokers-public", "title": "Offset Smokers", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "grill and smoker record", "ladder_rank": 5, "body": "Offset smokers burn wood in a side firebox; heat and smoke flow across the cooking chamber. Thin blue smoke is the goal — thick white smoke tastes bitter. Maintain 225 to 275 degrees for most barbecue. Split wood into fist-sized pieces for clean burning. Rest brisket and pork shoulder wrapped in a cooler for at least an hour before slicing.", "capabilities": ["Explain offset firebox design", "Describe thin-blue-smoke goal", "Give barbecue temperature range", "Explain wood splitting", "Explain the resting rule"], "demo": {"language": "javascript", "title": "Cook time estimate", "code": "const lbs=12,perLb=1.25;J({hours:lbs*perLb});assert(lbs*perLb===15,'offset');", "verified_output": "{\"hours\":15}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Grills Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Charcoal Grills", "Gas Grills", "Pellet Grills"], "sibling_edition": "grills-smokers-public-signature"}}
{"id": "JAH-GRILL-000006", "slug": "grills-smokers-public", "title": "Electric Smokers", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "grill and smoker record", "ladder_rank": 6, "body": "Electric smokers use a heating element and a wood-chip tray — plug in and smoke. They hold temperature automatically, making them the easiest entry to smoking. Add chips every hour or so for continuous smoke. They produce less smoke ring than wood burners but plenty of flavor. Use them where open flame is banned: apartments, condos, and fire-restricted areas.", "capabilities": ["Explain electric-smoker operation", "Describe chip-tray use", "Explain ease-of-use advantage", "Discuss smoke-ring differences", "List restricted-area uses"], "demo": {"language": "javascript", "title": "Chip schedule", "code": "const hours=6,perHour=1;J({chip_loads:hours*perHour});assert(hours*perHour===6,'echips');", "verified_output": "{\"chip_loads\":6}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Grills Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Charcoal Grills", "Gas Grills", "Pellet Grills"], "sibling_edition": "grills-smokers-public-signature"}}
{"id": "JAH-GRILL-000007", "slug": "grills-smokers-public", "title": "Direct vs Indirect Heat", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "grill and smoker record", "ladder_rank": 7, "body": "Direct heat cooks food right over the fire — best for thin, fast items like burgers, steaks, and vegetables. Indirect heat cooks beside the fire with the lid closed — best for thick items like whole chickens and roasts. Two-zone setups give both at once. Sear over direct heat, then move to indirect to finish without burning. Lid position matters: closed lid for indirect, open for direct searing.", "capabilities": ["Define direct heat", "Define indirect heat", "Describe two-zone setups", "Explain sear-then-move", "Explain lid-position rules"], "demo": {"language": "javascript", "title": "Heat zone split", "code": "const total=100,direct=50;J({indirect:total-direct});assert(total-direct===50,'zones');", "verified_output": "{\"indirect\":50}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Grills Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Charcoal Grills", "Gas Grills", "Pellet Grills"], "sibling_edition": "grills-smokers-public-signature"}}
{"id": "JAH-GRILL-000008", "slug": "grills-smokers-public", "title": "Grill Safety and Care", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "grill and smoker record", "ladder_rank": 8, "body": "Place grills well away from the house, railings, and overhangs — never in a garage. Clean grates with a brush while hot; oiled grates prevent sticking. For gas grills, turn burners off first, then the tank. Dispose of charcoal ash only when fully cold — embers hide for days. Cover the grill to protect it, and deep-clean grease traps to prevent fires.", "capabilities": ["Give grill placement rules", "Explain hot-grate brushing", "Describe gas shutoff order", "Explain ash-disposal safety", "Explain grease-trap cleaning"], "demo": {"language": "javascript", "title": "Clearance rule", "code": "const clearance_ft=10;J({min_ft:clearance_ft});assert(clearance_ft>=10,'grillsafe');", "verified_output": "{\"min_ft\":10}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Grills Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Charcoal Grills", "Gas Grills", "Pellet Grills"], "sibling_edition": "grills-smokers-public-signature"}}
