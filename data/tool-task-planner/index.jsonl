{"id": "JAH-TOOL-TASKPLAN-000002", "slug": "tool-task-planner", "title": "Task Planner \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Structured task definition, available tool registry. Outputs: Ordered plan: steps with tools, inputs, dependencies, checkpoints.", "capabilities": ["Decompose tasks into tool-sized steps", "Assign a capable tool per step", "Map dependencies between steps", "Insert verification checkpoints", "Estimate step count and risk"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const task={goal:'publish report',constraints:['by Friday'],done:'PDF delivered'};const ok=task.goal&&task.done;J({valid:!!ok});assert(ok,'contract');", "verified_output": "{\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Task Planner Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Task Interpreter", "Step Sequencer", "Workflow Engine"], "sibling_edition": "tool-task-planner-signature"}}
{"id": "JAH-TOOL-TASKPLAN-000003", "slug": "tool-task-planner", "title": "Task Planner \u2014 Core capabilities", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 5, "body": "Public edition. Public tool knowledge, fact-checked reference. Capabilities: Decompose tasks into tool-sized steps; Assign a capable tool per step; Map dependencies between steps; Insert verification checkpoints; Estimate step count and risk.", "capabilities": ["Decompose tasks into tool-sized steps", "Assign a capable tool per step", "Map dependencies between steps", "Insert verification checkpoints", "Estimate step count and risk"], "demo": {"language": "javascript", "title": "Core operation executed", "code": "const steps=[{id:'a',deps:[]},{id:'b',deps:['a']},{id:'c',deps:['a']},{id:'d',deps:['b','c']}];const done=new Set(),order=[];while(order.length<steps.length){const nxt=steps.find(s=>!done.has(s.id)&&s.deps.every(d=>done.has(d)));if(!nxt)throw new Error('cycle');done.add(nxt.id);order.push(nxt.id);}J({order});assert(order[0]==='a'&&order[3]==='d','topo');", "verified_output": "{\"order\":[\"a\",\"b\",\"c\",\"d\"]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Task Planner Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Task Interpreter", "Step Sequencer", "Workflow Engine"], "sibling_edition": "tool-task-planner-signature"}}
{"id": "JAH-TOOL-TASKPLAN-000004", "slug": "tool-task-planner", "title": "Task Planner \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Plan 'publish a monthly report': 9 steps from data gathering through verification, with dependencies and two checkpoints.", "capabilities": ["Decompose tasks into tool-sized steps", "Assign a capable tool per step", "Map dependencies between steps", "Insert verification checkpoints", "Estimate step count and risk"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "function solveQuad(a,b,c){const d=b*b-4*a*c;if(d<0)return[];const s=Math.sqrt(d);return [(-b-s)/(2*a),(-b+s)/(2*a)];}const roots=solveQuad(3,-5,-2);const check=roots.map(r=>3*r*r-5*r-2);J({roots:roots.map(r=>+r.toFixed(4)),residuals:check.map(x=>+x.toExponential(1))});assert(Math.abs(check[0])<1e-9&&Math.abs(check[1])<1e-9,'verify');", "verified_output": "{\"roots\":[-0.3333,2],\"residuals\":[-2.2e-16,0]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Task Planner Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Task Interpreter", "Step Sequencer", "Workflow Engine"], "sibling_edition": "tool-task-planner-signature"}}
{"id": "JAH-TOOL-TASKPLAN-000005", "slug": "tool-task-planner", "title": "Task Planner \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Plans are only as good as the task definition; it replans when a step fails rather than forcing through.", "capabilities": ["Decompose tasks into tool-sized steps", "Assign a capable tool per step", "Map dependencies between steps", "Insert verification checkpoints", "Estimate step count and risk"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "function checkLogic(premises,conclusion){const rainWet=premises.includes('rain->wet');if(conclusion==='rained'&&premises.includes('wet')&&!premises.includes('rain'))return {valid:false,fallacy:'affirming the consequent'};return {valid:true};}const r=checkLogic(['rain->wet','wet'],'rained');J(r);assert(r.valid===false&&r.fallacy,'logic');", "verified_output": "{\"valid\":false,\"fallacy\":\"affirming the consequent\"}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Task Planner Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Task Interpreter", "Step Sequencer", "Workflow Engine"], "sibling_edition": "tool-task-planner-signature"}}
{"id": "JAH-TOOL-TASKPLAN-000006", "slug": "tool-task-planner", "title": "Task Planner \u2014 Beginner teaching exercise", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 2, "body": "Public edition. Public tool knowledge, fact-checked reference. Start simple: identify the tool's single core action for Task Planner, run it once on a tiny input, and verify the output matches expectations before scaling up.", "capabilities": ["Decompose tasks into tool-sized steps", "Assign a capable tool per step", "Map dependencies between steps", "Insert verification checkpoints", "Estimate step count and risk"], "demo": {"language": "javascript", "title": "Teaching exercise: beginner", "code": "const facts={fileExists:true,backupExists:true,approved:false};const cond=facts.fileExists&&facts.backupExists&&facts.approved;J({gate:'delete',pass:cond,evidence:facts});assert(cond===false,'gate');", "verified_output": "{\"gate\":\"delete\",\"pass\":false,\"evidence\":{\"fileExists\":true,\"backupExists\":true,\"approved\":false}}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Task Planner Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Task Interpreter", "Step Sequencer", "Workflow Engine"], "sibling_edition": "tool-task-planner-signature"}}
{"id": "JAH-TOOL-TASKPLAN-000007", "slug": "tool-task-planner", "title": "Task Planner \u2014 Advanced pattern", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 11, "body": "Public edition. Public tool knowledge, fact-checked reference. Advanced use of Task Planner composes it with neighboring tools: chain its output into the next tool, add verification checkpoints, and automate the sequence once the manual path is proven.", "capabilities": ["Decompose tasks into tool-sized steps", "Assign a capable tool per step", "Map dependencies between steps", "Insert verification checkpoints", "Estimate step count and risk"], "demo": {"language": "javascript", "title": "Advanced pattern: weighted option comparison", "code": "const opts=[{n:'A',price:800,batt:10},{n:'B',price:1000,batt:16},{n:'C',price:700,batt:8}];const w={price:0.5,batt:0.5};const norm=(v,vs)=>1-(v-Math.min(...vs))/(Math.max(...vs)-Math.min(...vs)||1);const scored=opts.map(o=>({n:o.n,score:+(norm(o.price,opts.map(x=>x.price))*w.price+(o.batt/16)*w.batt).toFixed(3)})).sort((a,b)=>b.score-a.score);J({ranked:scored});assert(scored[0].n==='C','compare');", "verified_output": "{\"ranked\":[{\"n\":\"C\",\"score\":0.75},{\"n\":\"A\",\"score\":0.646},{\"n\":\"B\",\"score\":0.5}]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Task Planner Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Task Interpreter", "Step Sequencer", "Workflow Engine"], "sibling_edition": "tool-task-planner-signature"}}
