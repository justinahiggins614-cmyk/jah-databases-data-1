{"id": "JAH-TOOL-FILEWATC-000002", "slug": "tool-file-watcher", "title": "File Watcher \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Directory paths, filters, debounce window. Outputs: Change events: path, change type, timestamp.", "capabilities": ["Create/modify/rename/delete detection", "Debounced event coalescing", "Noise filters for temp and swap files", "Recursive directory monitoring", "Persistent change log"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const job={name:'nightly',schedule:'0 2 * * *'};const ok=job.name&&job.schedule.split(' ').length===5;J({valid:!!ok});assert(ok,'contract');", "verified_output": "{\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH File Watcher Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Event Listener", "Batch Processor", "Audit Logger"], "sibling_edition": "tool-file-watcher-signature"}}
