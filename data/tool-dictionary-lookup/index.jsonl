{"id": "JAH-TOOL-DICTIONA-000002", "slug": "tool-dictionary-lookup", "title": "Dictionary Lookup \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Word or phrase, detail level. Outputs: Dictionary entry: senses, POS, examples, pronunciation.", "capabilities": ["Definitions with part of speech", "Lemmatization of inflected forms", "Spelling suggestions for near-misses", "Example sentences per sense", "Pronunciation guidance"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const q={query:'zip permissions',count:5};const ok=typeof q.query==='string'&&q.count>0&&q.count<=50;J({query:q.query,valid:!!ok});assert(ok,'contract');", "verified_output": "{\"query\":\"zip permissions\",\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Dictionary Lookup Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Encyclopedia Lookup", "Translation Tool", "Text Extractor (OCR)"], "sibling_edition": "tool-dictionary-lookup-signature"}}
{"id": "JAH-TOOL-DICTIONA-000003", "slug": "tool-dictionary-lookup", "title": "Dictionary Lookup \u2014 Core capabilities", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 5, "body": "Public edition. Public tool knowledge, fact-checked reference. Capabilities: Definitions with part of speech; Lemmatization of inflected forms; Spelling suggestions for near-misses; Example sentences per sense; Pronunciation guidance.", "capabilities": ["Definitions with part of speech", "Lemmatization of inflected forms", "Spelling suggestions for near-misses", "Example sentences per sense", "Pronunciation guidance"], "demo": {"language": "javascript", "title": "Core operation executed", "code": "const docs=[{id:1,text:'zip archives store permissions in external attributes'},{id:2,text:'tar preserves unix permissions'},{id:3,text:'png images use lossless compression'}];const q='permissions';const hits=docs.filter(d=>d.text.includes(q)).map(d=>d.id);J({query:q,hits});assert(JSON.stringify(hits)==='[1,2]','search');", "verified_output": "{\"query\":\"permissions\",\"hits\":[1,2]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Dictionary Lookup Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Encyclopedia Lookup", "Translation Tool", "Text Extractor (OCR)"], "sibling_edition": "tool-dictionary-lookup-signature"}}
{"id": "JAH-TOOL-DICTIONA-000004", "slug": "tool-dictionary-lookup", "title": "Dictionary Lookup \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Look up 'serendipity': return its senses with examples, then check the spelling of 'accomodate' and suggest the correction.", "capabilities": ["Definitions with part of speech", "Lemmatization of inflected forms", "Spelling suggestions for near-misses", "Example sentences per sense", "Pronunciation guidance"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const rows=[['tool','kind'],['reader','file'],['parser','document']];const csv=rows.map(r=>r.map(c=>'\"'+c.replace(/\"/g,'\"\"')+'\"').join(',')).join('\\n');const back=csv.split('\\n').map(l=>l.split(',').map(c=>c.replace(/^\"|\"$/g,'')));J({rows:back.length,roundtrip:JSON.stringify(back)===JSON.stringify(rows)});assert(back.length===3,'csv');", "verified_output": "{\"rows\":3,\"roundtrip\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Dictionary Lookup Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Encyclopedia Lookup", "Translation Tool", "Text Extractor (OCR)"], "sibling_edition": "tool-dictionary-lookup-signature"}}
{"id": "JAH-TOOL-DICTIONA-000005", "slug": "tool-dictionary-lookup", "title": "Dictionary Lookup \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. General vocabulary; technical jargon may need domain dictionaries; definitions are reference data, not legal advice.", "capabilities": ["Definitions with part of speech", "Lemmatization of inflected forms", "Spelling suggestions for near-misses", "Example sentences per sense", "Pronunciation guidance"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const ROBOTS={'example.com':['/private']};function fetchable(url){const u=new URL(url);return !(ROBOTS[u.hostname]||[]).some(p=>u.pathname.startsWith(p));}J({url:'https://example.com/private/x',fetchable:fetchable('https://example.com/private/x')});assert(!fetchable('https://example.com/private/x'),'robots');", "verified_output": "{\"url\":\"https://example.com/private/x\",\"fetchable\":false}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Dictionary Lookup Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Encyclopedia Lookup", "Translation Tool", "Text Extractor (OCR)"], "sibling_edition": "tool-dictionary-lookup-signature"}}
