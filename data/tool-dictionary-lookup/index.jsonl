{"id": "JAH-TOOL-DICTIONA-000001", "slug": "tool-dictionary-lookup", "title": "Dictionary Lookup \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Retrieves word meanings, spellings, and usage. The Dictionary Lookup retrieves definitions, part of speech, pronunciation guidance, and example usage for words. It handles inflected forms by lemmatizing to the headword, suggests corrections for misspellings, and returns concise entries suitable for both humans and downstream language tools.", "capabilities": ["Definitions with part of speech", "Lemmatization of inflected forms", "Spelling suggestions for near-misses", "Example sentences per sense", "Pronunciation guidance"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Dictionary Lookup\",\"capabilities\":[\"Definitions with part of speech\",\"Lemmatization of inflected forms\",\"Spelling suggestions for near-misses\",\"Example sentences per sense\",\"Pronunciation guidance\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Dictionary Lookup Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Encyclopedia Lookup",