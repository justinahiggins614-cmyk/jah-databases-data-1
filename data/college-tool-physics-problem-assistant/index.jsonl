{"id": "JAH-CTOOL-PHYSICSP-000002", "slug": "college-tool-physics-problem-assistant", "title": "Physics Problem Assistant \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Problem statement, known values with units. Outputs: Step-by-step solution with principle, equation, and checks.", "capabilities": ["Identify the physical principle in a problem", "List knowns and unknowns with units", "Select and apply the right equation", "Show every algebraic step", "Check units and order of magnitude"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const expr='2+3*4';const ok=/^[0-9+\\-*/(). ^]+$/.test(expr);J({expression:expr,valid:ok});assert(ok,'contract');", "verified_output": "{\"expression\":\"2+3*4\",\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-college-student-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Physics Problem Assistant Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Equation Solver", "Unit Converter", "Scientific Calculator"], "sibling_edition": "college-tool-physics-problem-assistant-signature"}}
