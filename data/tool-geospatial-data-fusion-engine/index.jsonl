{"id": "JAH-TOOL-GEOSPATI-000004", "slug": "tool-geospatial-data-fusion-engine", "title": "Geospatial Data Fusion Engine \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Fuse 3 elevation sources over a grid: align, weight by stated accuracy, flag the 5 cells where sources disagree by >10 m.", "capabilities": ["Coordinate-system alignment", "Overlap reconciliation", "Reliability-weighted merging", "Per-cell source attribution", "Conflict flagging"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const before=[[1,1,1],[1,2,1],[1,1,1]],after=[[1,1,1],[1,9,1],[1,1,1]];const changes=[];for(let y=0;y<3;y++)for(let x=0;x<3;x++)if(Math.abs(after[y][x]-before[y][x])>3)changes.push([x,y]);J({changedCells:changes});assert(changes.length===1,'change');", "verified_output": "{\"changedCells\":[[1,1]]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Geospatial Data Fusion Engine Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Satellite Imagery Analysis Engine", "Terrain Reconstruction Tool", "Cross-Database Intelligence Engine"], "sibling_edition": "tool-geospatial-data-fusion-engine-signature"}}
{"id": "JAH-TOOL-GEOSPATI-000005", "slug": "tool-geospatial-data-fusion-engine", "title": "Geospatial Data Fusion Engine \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Fusion quality depends on source metadata honesty; it reconciles, it does not create ground truth. Capability specification and design target: this database describes what the tool must do, not a claim of implementation or deployment. Defensive and engineering content only \u2014 no weapon-targeting or attack-execution content.", "capabilities": ["Coordinate-system alignment", "Overlap reconciliation", "Reliability-weighted merging", "Per-cell source attribution", "Conflict flagging"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const pts=[{x:0,y:0,z:10}];function interp(x,y){let num=0,den=0;pts.forEach(p=>{const d=Math.hypot(x-p.x,y-p.y)||1e-6;num+=p.z/d;den+=1/d;});return num/den;}const v=interp(0.001,0);J({atSample:+v.toFixed(1)});assert(Math.abs(v-10)<0.5,'idw');", "verified_output": "{\"atSample\":10}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Geospatial Data Fusion Engine Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Satellite Imagery Analysis Engine", "Terrain Reconstruction Tool", "Cross-Database Intelligence Engine"], "sibling_edition": "to