{"id": "JAH-FOG-ARCH-000001", "slug": "fog-computing-architecture", "title": "Fog Computing Architecture \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "fog data science database record", "ladder_rank": 1, "body": "Public edition. Public fog data science knowledge, fact-checked reference. The layered architecture of fog computing: device, fog, and cloud tiers working as one system. Fog computing extends cloud services to the edge of the network: a three-tier architecture where the device tier (sensors, actuators, phones) talks to the fog tier (gateways, routers, edge servers, micro data centers) which talks to the cloud tier (central data centers). Cisco introduced the term in 2012; the OpenFog Consortium (2015) published the reference architecture later consolidated under IEEE. Fog nodes provide compute, storage, and networking between the device and the cloud, cutting round trips, saving bandwidth, and keeping latency-sensitive work close to where data is born.", "concepts": ["three-tier fog model", "fog node", "fog cluster", "northbound/southbound interfaces", "fog gateway", "fog-to-cloud federation", "hierarchical fog", "peer fog collaboration", "fog orchestrator", "device-fog-cloud continuum"], "demo": {"language": "javascript", "title": "Overview and concept inventory", "code": "J({topic:__TOPIC__.name,concepts:__TOPIC__.concepts,count:__TOPIC__.concepts.length});assert(__TOPIC__.concepts.length>=5,'concepts');", "verified_output": "{\"topic\":\"Fog Computing Architecture\",\"concepts\":[\"three-tier fog model\",\"fog node\",\"fog cluster\",\"northbound/southbound interfaces\",\"fog gateway\",\"fog-to-cloud federation\",\"hierarchical fog\",\"peer fog collaboration\",\"fog orchestrator\",\"device-fog-cloud continuum\"],\"count\":10}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_order": "manons-orders-2026-10-20-database-batch.txt item 89 (fog data science)", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Fog Computing Architecture Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["fog-nodes-orchestration", "fog-vs-cloud-vs-edge", "fog-data-lifecycle", "fog-data-science-master"], "sibling_edition": "fog-computing-architecture-signature"}}
{"id": "JAH-FOG-ARCH-000002", "slug": "fog-computing-architecture", "title": "Fog Computing Architecture \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "fog data science database record", "ladder_rank": 3, "body": "Public edition. Public fog data science knowledge, fact-checked reference. Inputs: sensor streams, device telemetry, application workloads, network topology maps. Outputs: tiered deployment plan, task placement map, latency budget table.", "concepts": ["three-tier fog model", "fog node", "fog cluster", "northbound/southbound interfaces", "fog gateway", "fog-to-cloud federation", "hierarchical fog", "peer fog collaboration", "fog orchestrator", "device-fog-cloud continuum"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const req={workload_id:'wl-1',fog_node:'fog-1',deadline_ms:20,payload_kb:64};const ok=req.workload_id&&req.fog_node&&req.deadline_ms>0&&req.payload_kb<=1024;J({request:req,valid:!!ok});assert(ok,'contract');", "verified_output": "{\"request\":{\"workload_id\":\"wl-1\",\"fog_node\":\"fog-1\",\"deadline_ms\":20,\"payload_kb\":64},\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_order": "manons-orders-2026-10-20-database-batch.txt item 89 (fog data science)", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Fog Computing Architecture Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["fog-nodes-orchestration", "fog-vs-cloud-vs-edge", "fog-data-lifecycle", "fog-data-science-master"], "sibling_edition": "fog-