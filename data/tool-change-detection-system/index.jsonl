{"id": "JAH-TOOL-CHANGEDE-000002", "slug": "tool-change-detection-system", "title": "Change Detection System \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Before/after observations, thresholds. Outputs: Change map with regions and confidence.", "capabilities": ["Pixel-level difference mapping", "Changed-region detection", "Change-magnitude statistics", "Noise-vs-change thresholding", "Per-region confidence"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const inp={bands:['red','nir'],size:10};const ok=inp.bands.length===2;J({valid:!!ok});assert(ok,'contract');", "verified_output": "{\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Change Detection System Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Satellite Imagery Analysis Engine", "Terrain Reconstruction Tool", "Video Analyzer"], "sibling_edition": "tool-change-detection-system-signature"}}
{"id": "JAH-TOOL-CHANGEDE-000003", "slug": "tool-change-detection-system", "title": "Change Detection System \u2014 Core capabilities", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 5, "body": "Public edition. Public tool knowledge, fact-checked reference. Capabilities: Pixel-level difference mapping; Changed-region detection; Change-magnitude statistics; Noise-vs-change thresholding; Per-region confidence.", "capabilities": ["Pixel-level difference mapping", "Changed-region detection", "Change-magnitude statistics", "Noise-vs-change thresholding", "Per-region confidence"], "demo": {"language": "javascript", "title": "Core operation executed", "code": "const red=[0.2,0.3,0.25],nir=[0.6,0.65,0.5];const ndvi=nir.map((n,i)=>+((n-red[i])/(n+red[i])).toFixed(2));J({ndvi,mean:+(ndvi.reduce((a,b)=>a+ +b,0)/3).toFixed(2)});assert(ndvi.every(v=>v>0.3),'ndvi');", "verified_output": "{\"ndvi\":[0.5,0.37,0.33],\"mean\":0.4}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Change Detection System Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Satellite Imagery Analysis Engine", "Terrain Reconstruction Tool", "Video Analyzer"], "sibling_edition": "tool-change-detection-system-signature"}}
{"id": "JAH-TOOL-CHANGEDE-000004", "slug": "tool-change-detection-system", "title": "Change Detection System \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Compare two 20x20 scenes: detect the new 4x3 cleared region at 94% confidence, ignore the 2% sensor noise.", "capabilities": ["Pixel-level difference mapping", "Changed-region detection", "Change-magnitude statistics", "Noise-vs-change thresholding", "Per-region confidence"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const before=[[1,1,1],[1,2,1],[1,1,1]],after=[[1,1,1],[1,9,1],[1,1,1]];const changes=[];for(let y=0;y<3;y++)for(let x=0;x<3;x++)if(Math.abs(after[y][x]-before[y][x])>3)changes.push([x,y]);J({changedCells:changes});assert(changes.length===1,'change');", "verified_output": "{\"changedCells\":[[1,1]]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Change Detection System Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Satellite Imagery Analysis Engine", "Terrain Reconstruction Tool", "Video Analyzer"], "sibling_edition": "tool-change-detection-system-signature"}}
{"id": "JAH-TOOL-CHANGEDE-000005", "slug": "tool-change-detection-system", "title": "Change Detection System \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Needs co-registered observations; lighting and seasonal differences cause false positives \u2014 thresholds must be tuned. Capability specification and design target: this database describes what the tool must do, not a claim of implementation or deployment. Defensive and engineering content only \u2014 no weapon-targeting or attack-execution content.", "capabilities": ["Pixel-level difference mapping", "Changed-region detection", "Change-magnitude statistics", "Noise-vs-change thresholding", "Per-region confidence"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const pts=[{x:0,y:0,z:10}];function interp(x,y){let num=0,den=0;pts.forEach(p=>{const d=Math.hypot(x-p.x,y-p.y)||1e-6;num+=p.z/d;den+=1/d;});return num/den;}const v=interp(0.001,0);J({atSample:+v.toFixed(1)});assert(Math.abs(v-10)<0.5,'idw');", "verified_output": "{\"atSample\":10}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Change Detection System Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Satellite Imagery Analysis Engine", "Terrain Reconstruction Tool", "Video Analyzer"], "sibling_edition": "tool-change-detection-system-signature"}}
