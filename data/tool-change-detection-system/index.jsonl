{"id": "JAH-TOOL-CHANGEDE-000001", "slug": "tool-change-detection-system", "title": "Change Detection System \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Compares observations across time to identify surface changes. The Change Detection System compares two observations of the same area taken at different times and identifies what changed: pixel-level difference maps, changed-region bounding boxes, and change magnitude statistics. It distinguishes real change from noise with thresholds and reports confidence per region. An observation-comparison method. Capability specification and design target: this database describes what the tool must do, not a claim of implementation or deployment. Defensive and engineering content only \u2014 no weapon-targeting or attack-execution content.", "capabilities": ["Pixel-level difference mapping", "Changed-region detection", "Change-magnitude statistics", "Noise-vs-change thresholding", "Per-region confidence"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Change Detection System\",\"capabilities\":[\"Pixel-level difference mapping\",\"Changed-region detection\",\"Change-magnitude statistics\",\"Noise-vs-change thresholding\",\"Per-region confidence\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive"