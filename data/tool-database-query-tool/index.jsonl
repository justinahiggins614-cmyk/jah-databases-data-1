nt_maker": true}, "links": {"related": ["Database Connector", "Record Validator", "Index Builder"], "sibling_edition": "tool-database-query-tool-signature"}}
{"id": "JAH-TOOL-DATABASEQ-000002", "slug": "tool-database-query-tool", "title": "Database Query Tool \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Database, query string, result limit. Outputs: Matching records with fields, plus the query plan.", "capabilities": ["SQL querying for relational databases", "Filter queries for document stores", "Syntax validation before execution", "Result-size caps with pagination", "Query-plan explanation"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const schema={required:['title'],types:{title:'string'}};const rec={title:'x'};const missing=schema.required.filter(k=>!(k in rec));J({missing});assert(missing.length===0,'contract');", "verified_output": "{\"missing\":[]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Database Query Tool Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Database Connector", "Record Validator", "Index Builder"], "sibling_edition": "tool-database-query-tool-signature"}}
