{"id": "JAH-TOOL-DATABASEQ-000004", "slug": "tool-database-query-tool", "title": "Database Query Tool \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Query the tools database for all monitoring tools: return their names and taglines, capped at 50 rows, with the plan shown.", "capabilities": ["SQL querying for relational databases", "Filter queries for document stores", "Syntax validation before execution", "Result-size caps with pagination", "Query-plan explanation"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const db=new Map([['a',{v:1}],['b',{v:2}],['c',{v:3}]]);const q=[...db.entries()].filter(([k,r])=>r.v>1).map(([k])=>k);J({matched:q});assert(q.length===2,'query');", "verified_output": "{\"matched\":[\"b\",\"c\"]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Database Query Tool Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Database Connector", "Record Validator", "Index Builder"], "sibling_edition": "tool-database-query-tool-signature"}}
{"id": "JAH-TOOL-DATABASEQ-000005", "slug": "tool-database-query-tool", "title": "Database Query Tool \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Read-only by default; write queries need explicit elevation; huge result sets paginate.", "capabilities": ["SQL querying for relational databases", "Filter queries for document stores", "Syntax validation before execution", "Result-size caps with pagination", "Query-plan explanation"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const db=new Map();function create(r){if([...db.values()].some(x=>x.key===r.key))return {error:'duplicate'};db.set(r.key,r);return {ok:true};}create({key:'k1'});const r2=create({key:'k1'});J(r2);assert(r2.error==='duplicate','unique');", "verified_output": "{\"error\":\"duplicate\"}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Database Query Tool Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Database Connector", "Record Validator", "Index Builder"], "sibling_edition": "tool-database-query-tool-signature"}}
