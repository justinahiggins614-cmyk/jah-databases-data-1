{"id": "JAH-FOG-REALDEPL-000001", "slug": "fog-real-world-deployments", "title": "Real-World Fog Deployments \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "fog data science database record", "ladder_rank": 1, "body": "Public edition. Public fog data science knowledge, fact-checked reference. Documented public fog deployments: smart cities, industry, health, vehicles, and grids. Public, documented fog deployments cluster in a few domains. Industrial IoT vendors ship edge/fog platforms for predictive maintenance (documented case studies from major automation vendors). Smart-city pilots use roadside and intersection fog for traffic signal control and video analytics. Healthcare deployments run fall detection and patient monitoring on local gateways to keep latency low and data on-premises. Energy utilities place fog at substations for grid monitoring and demand response. Connected-vehicle research programs test fog-based collision warnings. Cisco IOx is a widely documented fog application platform for network equipment.", "concepts": ["industrial predictive maintenance", "smart traffic control", "healthcare on-premises analytics", "substation grid monitoring", "connected vehicle warnings", "retail edge analytics", "fog application platforms", "pilot-to-production path", "documented ROI", "replication checklist"], "demo": {"language": "javascript", "title": "Overview and concept inventory", "code": "J({topic:__TOPIC__.name,concepts:__TOPIC__.concepts,count:__TOPIC__.concepts.length});assert(__TOPIC__.concepts.length>=5,'concepts');", "verified_output": "{\"topic\":\"Real-World Fog Deployments\",\"concepts\":[\"industrial predictive maintenance\",\"smart traffic control\",\"healthcare on-premises analytics\",\"substation grid monitoring\",\"connected vehicle warnings\",\"retail edge analytics\",\"fog application platforms\",\"pilot-to-production path\",\"documented ROI\",\"replication checklist\"],\"count\":10}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_order": "manons-orders-2026-10-20-database-batch.txt item 89 (fog data science)", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Real-World Fog Deployments Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["fog-computing-architecture", "fog-vs-cloud-vs-edge", "fog-simulators-tooling", "fog-data-science-master"], "sibling_edition": "fog-real-world-deployments-signature"}}
