{"id": "JAH-FOG-REALDEPL-000005", "slug": "fog-real-world-deployments", "title": "Real-World Fog Deployments \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "fog data science database record", "ladder_rank": 9, "body": "Public edition. Public fog data science knowledge, fact-checked reference. Public case studies are vendor-documented and selective; independent replications are rare; metrics rarely transfer directly between sites. This database records documented cases, not marketing claims.", "concepts": ["industrial predictive maintenance", "smart traffic control", "healthcare on-premises analytics", "substation grid monitoring", "connected vehicle warnings", "retail edge analytics", "fog application platforms", "pilot-to-production path", "documented ROI", "replication checklist"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const CAP=10n**15n;const request=1000n;const over=CAP+1n;const ok1=request<=CAP;const ok2=over<=CAP;const node={cpu:8,used:7};const job={cpu:4};const fits=node.used+job.cpu<=node.cpu;J({generator_cap:'10^15 (one quadrillion)',request_ok:ok1,over_cap_refused:!ok2,oversized_job_refused:!fits});assert(ok1&&!ok2&&!fits,'limits');", "verified_output": "{\"generator_cap\":\"10^15 (one quadrillion)\",\"request_ok\":true,\"over_cap_refused\":true,\"oversized_job_refused\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_order": "manons-orders-2026-10-20-database-batch.txt item 89 (fog data science)", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Real-World