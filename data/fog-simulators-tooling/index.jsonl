{"id": "JAH-FOG-SIMTOOL-000001", "slug": "fog-simulators-tooling", "title": "Fog Simulators and Tooling \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "fog data science database record", "ladder_rank": 1, "body": "Public edition. Public fog data science knowledge, fact-checked reference. The simulators and tools that let researchers model fog systems before building them. Fog research leans on simulation because real fleets are expensive. iFogSim (Gupta et al., 2017) is the most cited fog simulator: it models fog devices, sensors, actuators, and application modules with placement and scheduling policies. EdgeCloudSim adds mobility and WLAN/WAN modeling for edge scenarios. YAFS (Yet Another Fog Simulator) supports dynamic topologies and custom placement strategies. FogNetSim++ focuses on fog networking. Tooling around them includes workload generators, topology builders, and metric dashboards for latency, energy, and network usage.", "concepts": ["iFogSim", "EdgeCloudSim", "YAFS", "FogNetSim++", "discrete-event simulation", "placement policies", "mobility modeling", "workload traces", "energy models", "simulator comparison"], "demo": {"language": "javascript", "title": "Overview and concept inventory", "code": "J({topic:__TOPIC__.name,concepts:__TOPIC__.concepts,count:__TOPIC__.concepts.length});assert(__TOPIC__.concepts.length>=5,'concepts');", "verified_output": "{\"topic\":\"Fog Simulators and Tooling\",\"concepts\":[\"iFogSim\",\"EdgeCloudSim\",\"YAFS\",\"FogNetSim++\",\"discrete-event simulation\",\"placement policies\",\"mobility modeling\",\"workload traces\",\"energy models\",\"simulator comparison\"],\"count\":10}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_order": "manons-orders-2026-10-20-database-batch.txt item 89 (fog data science)", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Fog Simulators and Tooling Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["fog-nodes-orchestration", "fog-latency-optimization", "fog-future-research", "fog-data-science-master"], "sibling_edition": "fog-simulators-tooling-signature"}}
{"id": "JAH-FOG-SIMTOOL-000002", "slug": "fog-simulators-tooling", "title": "Fog Simulators and Tooling \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "fog data science database record", "ladder_rank": 3, "body": "Public edition. Public fog data science knowledge, fact-checked reference. Inputs: topology description, workload trace, simulator choice, experiment parameters. Outputs: simulation config, metrics report (latency, energy, network use), comparison table.", "concepts": ["iFogSim", "EdgeCloudSim", "YAFS", "FogNetSim++", "discrete-event simulation", "placement policies", "mobility modeling", "workload traces", "energy models", "simulator comparison"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const req={workload_id:'wl-1',fog_node:'fog-1',deadline_ms:20,payload_kb:64};const ok=req.workload_id&&req.fog_node&&req.deadline_ms>0&&req.payload_kb<=1024;J({request:req,valid:!!ok});assert(ok,'contract');", "verified_output": "{\"request\":{\"workload_id\":\"wl-1\",\"fog_node\":\"fog-1\",\"deadline_ms\":20,\"payload_kb\":64},\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_order": "manons-orders-2026-10-20-database-batch.txt item 89 (fog data science)", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Fog Simulators and Tooling Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["fog-nodes-orchestration", "fog-latency-optimization", "fog-future-research", "fog-data-science-master"], "sibling_edition": "fog-simulators-tooling-sig