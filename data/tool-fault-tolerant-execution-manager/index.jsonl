{"id": "JAH-TOOL-FAULTTOL-000001", "slug": "tool-fault-tolerant-execution-manager", "title": "Fault-Tolerant Execution Manager \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Detects execution failures and routes recoverable work around them. The Fault-Tolerant Execution Manager keeps work moving through failures: it detects failed tasks, classifies the failure, retries what is retryable, reroutes work to healthy workers, and checkpoints progress so nothing is lost. Unrecoverable failures are reported with the full context, never retried blindly. A resilience method for distributed work. Capability specification and design target: this database describes what the tool must do, not a claim of implementation or deployment. Defensive and engineering content only \u2014 no weapon-targeting or attack-execution content.", "capabilities": ["Failure detection and classification", "Retry-vs-reroute decisions", "Healthy-worker rerouting", "Progress checkpointing", "Full-context failure reports"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Fault-Tolerant Execution Manager\",\"capabilities\":[\"Failure detection and classification\",\"Retry-vs-reroute decisions\",\"Healthy-worker rerouting\",\"Progress checkpointing\",\"Full-context failure reports\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Fault-Tolerant Execution Manager Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Retry and Recovery Manager", "Distributed AI Inference Engine", "Checkpoint and Resume Manager"], "sibling_edition": "tool-fault-tolerant-execution-manager-signature"}}
{"id": "JAH-TOOL-FAULTTOL-000002", "slug": "tool-fault-tolerant-execution-manager", "title": "Fault-Tolerant Execution Manager \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Task set, worker pool, failure policy. Outputs: Completed results or classified failures with context.", "capabilities": ["Failure detection and classification", "Retry-vs-reroute decisions", "Healthy-worker rerouting", "Progress checkpointing", "Full-context failure reports"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const task={name:'train',affinity:'gpu',mem:8};const ok=['cpu','gpu'].includes(task.affinity);J({valid:!!ok});assert(ok,'contract');", "verified_output": "{\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Fault-Tolerant Execution Manager Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Retry and Recovery Manager", "Distributed AI Inference Engine", "Checkpoint and Resume Manager"], "sibling_edition": "tool-fault-tolerant-execution-manager-signature"}}
