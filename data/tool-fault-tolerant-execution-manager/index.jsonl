{"id": "JAH-TOOL-FAULTTOL-000004", "slug": "tool-fault-tolerant-execution-manager", "title": "Fault-Tolerant Execution Manager \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Run 20 tasks with 2 worker failures: reroute 6 tasks, retry 3, complete 19, report 1 unrecoverable with context.", "capabilities": ["Failure detection and classification", "Retry-vs-reroute decisions", "Healthy-worker rerouting", "Progress checkpointing", "Full-context failure reports"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const jobs=[{n:'a',cpu:4},{n:'b',cpu:8},{n:'c',cpu:2}];const cap=10;let bins=0,load=0;const sorted=[...jobs].sort((x,y)=>y.cpu-x.cpu);sorted.forEach(j=>{if(load+j.cpu>cap){bins++;load=0;}load+=j.cpu;});bins++;J({bins,lastLoad:load});assert(bins===2,'binpack');", "verified_output": "{\"bins\":2,\"lastLoad\":6}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Fault-Tolerant Execution Manager Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Retry and Recovery Manager", "Distributed AI Inference Engine", "Checkpoint and Resume Manager"], "sibling_edition": "tool-fault-tolerant-execution-manager-signature"}}
{"id": "JAH-TOOL-FAULTTOL-000005", "slug": "tool-fault-tolerant-execution-manager", "title": "Fault-Tolerant Execution Manager \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Handles modeled failure types; novel failures escalate; rerouting needs spare capacity \u2014 it reports when there is none. Capability specification and design target: this database describes what the tool must do, not a claim of implementation or deployment. Defensive and engineering content only \u2014 no weapon-targeting or attack-execution content.", "capabilities": ["Failure detection and classification", "Retry-vs-reroute decisions", "Healthy-worker rerouting", "Progress checkpointing", "Full-context failure reports"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const tiers={hot:2,warm:4};const items=['a','b','c','d','e','f','g'];const hot=items.slice(0,tiers.hot),warm=items.slice(tiers.hot,tiers.hot+tiers.warm),cold=items.slice(tiers.hot+tiers.warm);J({hot:warm.length,cold:cold.length,retrievable:hot.concat(warm,cold).length===7});assert(cold.length===1,'tiers');", "verified_output": "{\"hot\":4,\"cold\":1,\"retrievable\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Fault-Tolerant Execution Manager Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {