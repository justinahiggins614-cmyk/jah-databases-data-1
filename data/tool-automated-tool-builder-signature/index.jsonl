{"id": "JAH-SIG-AUTOMATE-000006", "slug": "tool-automated-tool-builder-signature", "title": "Automated Tool Builder \u2014 Beginner teaching exercise", "edition": "signature", "src": "signature-generated-completion", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 2, "body": "Signature edition. Original Signature methods and framings developed for the JAH system, labeled Signature throughout. Start simple: identify the tool's single core action for Automated Tool Builder, run it once on a tiny input, and verify the output matches expectations before scaling up.", "capabilities": ["Spec-to-code generation", "Test-suite generation per tool", "Execute-before-delivery verification", "Failure reporting with test names", "Documentation drafting"], "demo": {"language": "javascript", "title": "Teaching exercise: beginner", "code": "function broken(x){return 10/x;}const tests=[{in:2,exp:5},{in:0,exp:Infinity}];const results=tests.map(t=>({pass:broken(t.in)===t.exp}));J({passed:results.filter(r=>r.pass).length,total:2});assert(results.every(r=>r.pass),'selftest');", "verified_output": "{\"passed\":2,\"total\":2}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Automated Tool Builder Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["AI-Designed AI Generator", "Code Generator", "Test Runner"], "sibling_edition": "tool-automated-tool-builder"}}
