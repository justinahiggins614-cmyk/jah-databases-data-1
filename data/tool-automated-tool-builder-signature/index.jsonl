{"id": "JAH-SIG-AUTOMATE-000004", "slug": "tool-automated-tool-builder-signature", "title": "Automated Tool Builder \u2014 Worked example", "edition": "signature", "src": "signature-generated-completion", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Signature edition. Original Signature methods and framings developed for the JAH system, labeled Signature throughout. Specify a CSV row counter: generate the implementation, 4 tests, run them \u2014 4/4 pass, deliver with docs.", "capabilities": ["Spec-to-code generation", "Test-suite generation per tool", "Execute-before-delivery verification", "Failure reporting with test names", "Documentation drafting"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const spec={name:'row-counter',inputs:['csv'],outputs:['count']};const fname=spec.name.replace(/[^a-zA-Z0-9_]/g,'_');const code=`function ${fname}(rows){return rows.length;}`;const vm=require('vm');const sb={};vm.createContext(sb);const fn=vm.runInContext(code+';'+fname+';',sb);const r=fn([1,2,3]);J({generated:spec.name,codeLen:code.length,testCall:r});assert(code.includes('rows.length')&&r===3,'codegen');", "verified_output": "{\"generated\":\"row-counter\",\"codeLen\":47,\"testCall\":3}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Automated Tool Builder Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["AI-Designed AI Generator", "Code Generator", "Test Runner"], "sibli