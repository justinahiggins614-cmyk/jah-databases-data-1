{"id": "JAH-CONJOB-S-000008", "slug": "construction-jobs-signature", "title": "Construction Jobs — Signature Clean-Site Standard", "edition": "signature", "src": "signature-generated-completion", "built_by": "assistant-built", "record_kind": "construction job record", "ladder_rank": 15, "body": "Signature edition. Signature-original job concept. The Signature Clean-Site Standard makes the last 30 minutes of every day a paid cleanup with a named owner per oul cell: tools racked, offcuts binned, walkways swept, materials covered. A clean site has fewer trip injuries, fewer lost tools, and faster morning startups. The standard is posted, measured, and part of performance review. A Signature concept for study.", "capabilities": ["Assign cleanup owners per cell", "List the 30-minute cleanup tasks", "Measure trip-incident reduction", "Track tool loss before and after", "Review the standard quarterly"], "demo": {"language": "javascript", "title": "Signature cleanup time planner", "code": "const h=C.crew*C.minutes*C.days/60;assert(h===C.expected_hours,'hours');J({weekly_cleanup_hours:h});", "verified_output": "{\"weekly_cleanup_hours\":25}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Construction Jobs Signature Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Signature Master Builder Path", "Signature Trade-Swap Program", "Signature Pay-Ladder Transparency"], "sibling_edition": "construct