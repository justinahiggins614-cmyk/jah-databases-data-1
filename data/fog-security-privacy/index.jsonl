{"id": "JAH-FOG-SECPRIV-000004", "slug": "fog-security-privacy", "title": "Fog Security and Privacy \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "fog data science database record", "ladder_rank": 7, "body": "Public edition. Public fog data science knowledge, fact-checked reference. A smart-building deployment attests each floor gateway before it joins the fleet; camera feeds are anonymized at the gateway so only occupancy counts reach the cloud.", "concepts": ["mutual TLS", "remote attestation", "rogue node detection", "data minimization", "k-anonymity at the edge", "differential privacy", "secure aggregation", "key rotation", "zero-trust fog", "audit trails"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "// end-to-end: attest -> encrypt -> minimize -> audit receipt\nconst attest={node:'fog-1',firmware:'v3.2.1',expected:'v3.2.1',pass:true};\nconst cipher={alg:'AES-256-GCM',bytes:4096};const scrubbed={identifiers_removed:['name','device_id'],k:3};\nconst receipt={node:attest.node,attested:attest.pass,encrypted:cipher.alg,k_anon:scrubbed.k,ts:Date.UTC(2026,9,21)};\nJ({receipt});assert(receipt.attested&&receipt.k_anon>=2,'secure pipeline');", "verified_output": "{\"receipt\":{\"node\":\"fog-1\",\"attested\":true,\"encrypted\":\"AES-256-GCM\",\"k_anon\":3,\"ts\":1792540800000}}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_order": "manons-orders-2026-10-20-database-batch.txt item 89 (fog data science)", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Fog Security and Privacy Librarian", "scope"