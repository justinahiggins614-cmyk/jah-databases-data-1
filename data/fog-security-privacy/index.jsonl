{"id": "JAH-FOG-SECPRIV-000006", "slug": "fog-security-privacy", "title": "Fog Security and Privacy \u2014 Beginner teaching exercise", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "fog data science database record", "ladder_rank": 2, "body": "Public edition. Public fog data science knowledge, fact-checked reference. Start simple: define the fog computing stack (device, fog, cloud tiers) for Fog Security and Privacy, identify which tier each workload belongs on, and verify with a small latency-budget calculation before scaling up.", "concepts": ["mutual TLS", "remote attestation", "rogue node detection", "data minimization", "k-anonymity at the edge", "differential privacy", "secure aggregation", "key rotation", "zero-trust fog", "audit trails"], "demo": {"language": "javascript", "title": "Beginner teaching exercise: cloud vs fog round trip", "code": "const fog=T.nodes[0].rtt_ms;const cloud=T.cloud_rtt_ms;const saved=cloud-fog;const pct=Math.round(100*saved/cloud);J({fog_rtt_ms:fog,cloud_rtt_ms:cloud,saved_ms:saved,saving_pct:pct});assert(saved>0,'saves');assert(pct>50,'big win');", "verified_output": "{\"fog_rtt_ms\":5,\"cloud_rtt_ms\":115,\"saved_ms\":110,\"saving_pct\":96}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_order": "manons-orders-2026-10-20-database-batch.txt item 89 (fog data science)", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Fog Security and Privacy Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["fog-nodes-orchestration", "fog-distributed-ml", "fog-data-lifecycle", "fog-data-science-mast