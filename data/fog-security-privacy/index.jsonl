{"id": "JAH-FOG-SECPRIV-000003", "slug": "fog-security-privacy", "title": "Fog Security and Privacy \u2014 Core concepts", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "fog data science database record", "ladder_rank": 5, "body": "Public edition. Public fog data science knowledge, fact-checked reference. Core concepts: mutual TLS; remote attestation; rogue node detection; data minimization; k-anonymity at the edge; differential privacy; secure aggregation; key rotation; zero-trust fog; audit trails.", "concepts": ["mutual TLS", "remote attestation", "rogue node detection", "data minimization", "k-anonymity at the edge", "differential privacy", "secure aggregation", "key rotation", "zero-trust fog", "audit trails"], "demo": {"language": "javascript", "title": "Core operation executed", "code": "// core: k-anonymity check on a fog-tier record batch\nconst recs=[{zip:'10001',age:34},{zip:'10001',age:36},{zip:'10001',age:35},{zip:'90210',age:50},{zip:'90210',age:52}];\nconst groups={};recs.forEach(r=>{groups[r.zip]=(groups[r.zip]||0)+1;});\nconst k=2;const ok=Object.values(groups).every(c=>c>=k);\nJ({groups,passes_k2:ok,records:recs.length});assert(ok,'k-anon');", "verified_output": "{\"groups\":{\"10001\":3,\"90210\":2},\"passes_k2\":true,\"records\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_order": "manons-orders-2026-10-20-database-batch.txt item 89 (fog data science)", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Fog Security and Privacy Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["fog-nodes-orchest