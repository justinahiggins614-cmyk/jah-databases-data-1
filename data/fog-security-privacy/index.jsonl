{"id": "JAH-FOG-SECPRIV-000001", "slug": "fog-security-privacy", "title": "Fog Security and Privacy \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "fog data science database record", "ladder_rank": 1, "body": "Public edition. Public fog data science knowledge, fact-checked reference. Securing a sprawling, heterogeneous fog: identity, attestation, encryption, and data minimization. Fog security must cover thousands of physically exposed, heterogeneous nodes. Core practices: mutual authentication between devices, fog nodes, and cloud; remote attestation of node software; encryption in transit and at rest; fine-grained access control; and privacy by data minimization \u2014 aggregate and anonymize at the fog tier so raw personal data never travels upstream. Threats include rogue fog nodes, man-in-the-middle on local links, compromised gateways, and model-extraction attacks against edge ML.", "concepts": ["mutual TLS", "remote attestation", "rogue node detection", "data minimization", "k-anonymity at the edge", "differential privacy", "secure aggregation", "key rotation", "zero-trust fog", "audit trails"], "demo": {"language": "javascript", "title": "Overview and concept inventory", "code": "J({topic:__TOPIC__.name,concepts:__TOPIC__.concepts,count:__TOPIC__.concepts.length});assert(__TOPIC__.concepts.length>=5,'concepts');", "verified_output": "{\"topic\":\"Fog Security and Privacy\",\"concepts\":[\"mutual TLS\",\"remote attestation\",\"rogue node detection\",\"data minimization\",\"k-anonymity at the edge\",\"differential privacy\",\"secure aggregation\",\"key rotation\",\"zero-trust fog\",\"audit trails\"],\"count\":10}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_order": "manons-orders-2026-10-20-database-batch.txt item 89 (fog data science)", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "reco