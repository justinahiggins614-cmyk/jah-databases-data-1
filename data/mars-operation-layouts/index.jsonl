{"id": "JAH-MARSLAY-000006", "slug": "mars-operation-layouts", "title": "Mars Operation Layout — Mars Emergency Oul Plan (Speculative)", "edition": "signature", "src": "signature-generated-completion", "built_by": "assistant-built", "record_kind": "layout plan record", "ladder_rank": 10, "body": "Signature edition. SPECULATIVE Signature-concept. Every Mars layout includes emergency ouls: a storm shelter oul rated for dust storms, a medical oul, and a redundant airlock oul. Needs list: shelter supplies for 72 hours, medical kit, suit spares. Layout rule: every crewed oul must reach a shelter oul within a five-minute suited walk. A concept for study.", "capabilities": ["Pin the storm shelter oul", "Stock 72-hour supplies", "Place the medical oul centrally", "Verify five-minute shelter reach", "Track suit spares"], "demo": {"language": "javascript", "title": "Mars shelter reach checker (speculative)", "code": "const ok=C.walks_min.every(w=>w<=C.max_min);assert(ok===C.expected_ok,'reach');J({all_within_reach:ok});", "verified_output": "{\"all_within_reach\":true}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Mars Layout Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Mars Habitat Oul Grid (Speculative)", "Mars Landing Zone Layout (Speculative)", "Mars Greenhouse Oul Row (Speculative)"], "sibling_edition": "mars-operation-layouts-signature"}}
