{"id": "JAH-MARSLAY-000004", "slug": "mars-operation-layouts", "title": "Mars Operation Layout — Mars Workshop and Lab Row (Speculative)", "edition": "signature", "src": "signature-generated-completion", "built_by": "assistant-built", "record_kind": "layout plan record", "ladder_rank": 6, "body": "Signature edition. SPECULATIVE Signature-concept. The C-row workshop ouls pin 3D printers, machine tools, and electronics benches; the lab ouls pin geology and biology stations. Shared needs list: spare feedstock, tool bits, sample containers. Layout rule: the dirtiest fabrication oul sits farthest from the cleanest lab oul, with an airlock oul between. A concept for study.", "capabilities": ["Pin printers and machine tools", "Separate fabrication from labs", "Stock the shared needs list", "Place an airlock oul between", "Track sample containers"], "demo": {"language": "javascript", "title": "Mars workshop tool inventory (speculative)", "code": "assert(C.tools.length===C.expected,'tools');J({tools_pinned:C.tools.length});", "verified_output": "{\"tools_pinned\":5}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Mars Layout Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Mars Habitat Oul Grid (Speculative)", "Mars Landing Zone Layout (Speculative)", "Mars Greenhouse Oul Row (Speculative)"], "sibling_edition": "mars-operation-layouts-signature"}}
