{"id": "JAH-TOOL-EXPERTAI-000001", "slug": "tool-expert-ai-assembly-engine", "title": "Expert AI Assembly Engine \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Builds a temporary team of specialist agents for a particular problem. The Expert AI Assembly Engine assembles a temporary team of specialist agents matched to a specific problem: it reads the problem's demands, selects specialists from the registry (analyst, planner, verifier, domain expert), defines their roles and handoff protocol, and dissolves the team when the problem is solved. Every assembly is logged with why each specialist was chosen. Capability specification, not a claim of deployment. Capability specification and design target: this database describes what the tool must do, not a claim of implementation or deployment. Defensive and engineering content only \u2014 no weapon-targeting or attack-execution content.", "capabilities": ["Problem-demand analysis", "Specialist selection from the registry", "Role and handoff protocol definition", "Team lifecycle management", "Selection-rationale logging"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Expert AI Assembly Engine\",\"capabilities\":[\"Problem-demand analysis\",\"Specialist selection from the registry\",\"Role and handoff protocol definition\",\"Team lifecycle management\",\"Selection-rationale logging\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"targe