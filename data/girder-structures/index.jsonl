{"id": "JAH-GIRDER-000001", "slug": "girder-structures", "title": "Girder Structure — Model Girder Bridge Truss", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure record", "ladder_rank": 1, "body": "Public edition. Public build reference for model girder/beam structures (balsa, basswood, or metal strip). A Pratt truss bridge. Materials: 3/16-inch balsa strips, wood glue, pins, plans. Steps: (1) draw the full-size truss; (2) cut top chord, bottom chord, verticals, diagonals; (3) pin and glue one side on the plan; (4) build the mirror side; (5) join with lateral bracing; (6) deck and test. The Pratt truss: verticals in compression, diagonals in tension toward center. Tip: gusset every joint with a small plate — joints fail before members.", "capabilities": ["Draw the full-size truss", "Cut the members", "Pin and glue one side", "Mirror the second side", "Brace laterally and test"], "demo": {"language": "javascript", "title": "Model truss member counter", "code": "const m=C.panels*C.per_panel*2+2;assert(m===C.expected,'members');J({members:m});", "verified_output": "{\"members\":50}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Girder Structures Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Balsa Tower: Braced Frame", "Girder Cantilever Model"], "sibling_edition": "girder-structures-signature"}}
{"id": "JAH-GIRDER-000002", "slug": "girder-structures", "title": "Girder Structure — Balsa Tower: Braced Frame", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure record", "ladder_rank": 2, "body": "Public edition. Public build reference. A braced model tower. Materials: balsa strips, glue. Steps: (1) build four leg frames; (2) X-brace each face; (3) stack sections, tapering; (4) load-test from the top. Tip: balsa is strong along the grain — never load it across the grain.", "capabilities": ["Frame the legs", "X-brace each face", "Stack tapering sections", "Respect the grain", "Top-load test"], "demo": {"language": "javascript", "title": "Balsa tower section planner", "code": "const n=C.sections*C.per_section;assert(n===C.expected,'members');J({members_needed:n});", "verified_output": "{\"members_needed\":64}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Girder Structures Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Model Girder Bridge Truss", "Girder Cantilever Model"], "sibling_edition": "girder-structures-signature"}}
{"id": "JAH-GIRDER-000003", "slug": "girder-structures", "title": "Girder Structure — Girder Cantilever Model", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure record", "ladder_rank": 4, "body": "Public edition. Public build reference. A cantilever beam model. Materials: basswood strips, glue. Steps: (1) build the fixed support pier; (2) extend the beam in segments; (3) counterweight the back span; (4) load the tip and measure deflection. Tip: deflection grows with the cube of length — short cantilevers are easy, long ones are brutal.", "capabilities": ["Fix the support pier", "Segment the beam", "Counterweight the back", "Tip-load it", "Measure deflection"], "demo": {"language": "javascript", "title": "Cantilever deflection scaler", "code": "const r=(C.l2/C.l1)**3;assert(r===C.expected_ratio,'deflection');J({deflection_ratio:r});", "verified_output": "{\"deflection_ratio\":8}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Girder Structures Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Model Girder Bridge Truss", "Balsa Tower: Braced Frame"], "sibling_edition": "girder-structures-signature"}}
{"id": "JAH-GIRDER-000004", "slug": "girder-structures", "title": "Girder Structure — Steel-Strip Meccano-Style Frame", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure record", "ladder_rank": 6, "body": "Public edition. Public build reference for perforated metal strip construction sets. A rigid frame. Materials: perforated strips, bolts, nuts, angle brackets. Steps: (1) lay out the rectangle; (2) bolt corners with brackets; (3) add diagonal braces; (4) tighten in a star pattern; (5) check square. Tip: snug every bolt — one loose joint racks the whole frame.", "capabilities": ["Lay the rectangle", "Bracket the corners", "Brace diagonally", "Star-tighten bolts", "Check square"], "demo": {"language": "javascript", "title": "Strip frame bolt counter", "code": "const n=C.joints*C.bolts_per_joint;assert(n===C.expected,'bolts');J({bolts_needed:n});", "verified_output": "{\"bolts_needed\":16}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Girder Structures Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Model Girder Bridge Truss", "Balsa Tower: Braced Frame", "Girder Cantilever Model"], "sibling_edition": "girder-structures-signature"}}
{"id": "JAH-GIRDER-000005", "slug": "girder-structures", "title": "Girder Structure — Model Arch Bridge", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure record", "ladder_rank": 8, "body": "Public edition. Public build reference. A model arch. Materials: laminated balsa strips, glue, form. Steps: (1) build the arch form; (2) laminate 3 strips over the form; (3) cure on the form; (4) mount on piers; (5) deck and test. Tip: laminated arches are far stronger than cut curved pieces — the grain follows the curve.", "capabilities": ["Build the arch form", "Laminate over the form", "Cure on the form", "Mount on piers", "Deck and test"], "demo": {"language": "javascript", "title": "Arch laminate layer checker", "code": "const ok=C.layers>=C.min_layers;assert(ok===C.expected_ok,'layers');J({lamination_ok:ok});", "verified_output": "{\"lamination_ok\":true}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Girder Structures Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Model Girder Bridge Truss", "Balsa Tower: Braced Frame", "Girder Cantilever Model"], "sibling_edition": "girder-structures-signature"}}
{"id": "JAH-GIRDER-000006", "slug": "girder-structures", "title": "Girder Structure — Truss Joint Gusset Guide", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure record", "ladder_rank": 10, "body": "Public edition. Public build reference. Gussets: small plates glued/bolted over truss joints that spread the load and stop splitting. Cut gussets from thin plywood or card, size them to cover the joint plus member width on all sides, and glue both faces. Rule: a truss is only as strong as its worst joint.", "capabilities": ["Size the gusset plates", "Cover joint plus margin", "Glue both faces", "Cure under weight", "Inspect the worst joint"], "demo": {"language": "javascript", "title": "Gusset plate sizer", "code": "const s=C.member_w+2*C.margin;assert(Math.abs(s-C.expected)<0.001,'size');J({gusset_in:s});", "verified_output": "{\"gusset_in\":0.75}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Girder Structures Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Model Girder Bridge Truss", "Balsa Tower: Braced Frame", "Girder Cantilever Model"], "sibling_edition": "girder-structures-signature"}}
{"id": "JAH-GIRDER-000007", "slug": "girder-structures", "title": "Girder Structure — Beam Strength Basics", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure record", "ladder_rank": 12, "body": "Public edition. Public reference. Beam strength grows with depth: doubling a beam's depth makes it roughly 8 times stiffer. I-beams put material at the top and bottom flanges where stress is highest. For models: stand strips on edge (deep) not flat (shallow). Rule: depth beats width every time.", "capabilities": ["Explain the depth rule", "Orient strips on edge", "Read an I-beam section", "Compare two beam sizes", "Test to failure"], "demo": {"language": "javascript", "title": "Beam stiffness comparer", "code": "const r=(C.d2/C.d1)**3;assert(r===C.expected,'stiffness');J({stiffness_ratio:r});", "verified_output": "{\"stiffness_ratio\":8}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Girder Structures Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Model Girder Bridge Truss", "Balsa Tower: Braced Frame", "Girder Cantilever Model"], "sibling_edition": "girder-structures-signature"}}
{"id": "JAH-GIRDER-000008", "slug": "girder-structures", "title": "Girder Structure — Load Testing Models Safely", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure record", "ladder_rank": 15, "body": "Public edition. Public reference. Test models by loading gradually: hang a bucket and add sand or coins slowly, measure deflection at each step, and stop at the first crack sound. Record the failure load and where it broke — that is the lesson. Safety: wear eye protection; balsa snaps suddenly.", "capabilities": ["Load gradually", "Measure deflection", "Stop at first crack", "Record failure point", "Wear eye protection"], "demo": {"language": "javascript", "title": "Load test logger", "code": "const m=Math.max(...C.loads);assert(m===C.expected_max,'max');J({failure_load_g:m});", "verified_output": "{\"failure_load_g\":350}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Girder Structures Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Model Girder Bridge Truss", "Balsa Tower: Braced Frame", "Girder Cantilever Model"], "sibling_edition": "girder-structures-signature"}}
