{"id": "JAH-TOOL-RECORDVA-000001", "slug": "tool-record-validator", "title": "Record Validator \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Checks records for missing, invalid, or inconsistent fields. The Record Validator checks records against their schema: required fields present, types and formats correct, cross-field consistency (dates in order, counts matching lists), and identifier uniqueness. It reports every problem with the field and rule violated, and certifies clean records explicitly.", "capabilities": ["Schema conformance checking", "Type and format validation", "Cross-field consistency rules", "Uniqueness checks on key fields", "Clean-record certification"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Record Validator\",\"capabilities\":[\"Schema conformance checking\",\"Type and format validation\",\"Cross-field consistency rules\",\"Uniqueness checks on key fields\",\"Clean-record certification\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Record Validator Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Record Creator", "Duplicate Detector", "Result Verification Tool"], "sibling_edition": "tool-record-validator-signature"}}
{"id": "JAH-TOOL-RECORDVA-000002", "slug": "tool-record-validator", "title": "Record Validator \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Record(s), schema, consistency rules. Outputs: Validation report: violations per record or clean certification.", "capabilities": ["Schema conformance checking", "Type and format validation", "Cross-field consistency rules", "Uniqueness checks on key fields", "Clean-record certification"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const schema={required:['title'],types:{title:'string'}};const rec={title:'x'};const missing=schema.required.filter(k=>!(k in rec));J({missing});assert(missing.length===0,'contract');", "verified_output": "{\"missing\":[]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Record Validator Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Record Creator", "Duplicate Detector", "Result Verification Tool"], "sibling_edition": "tool-record-validator-signature"}}
{"id": "JAH-TOOL-RECORDVA-000003", "slug": "tool-record-validator", "title": "Record Validator \u2014 Core capabilities", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 5, "body": "Public edition. Public tool knowledge, fact-checked reference. Capabilities: Schema conformance checking; Type and format validation; Cross-field consistency rules; Uniqueness checks on key fields; Clean-record certification.", "capabilities": ["Schema conformance checking", "Type and format validation", "Cross-field consistency rules", "Uniqueness checks on key fields", "Clean-record certification"], "demo": {"language": "javascript", "title": "Core operation executed", "code": "const db=new Map();let n=0;function create(r){if(!r.title)throw new Error('title required');const id='JAH-REC-'+(++n);db.set(id,{...r,id});return id;}const id=create({title:'alpha'});J({id,record:db.get(id)});assert(db.get(id).title==='alpha','create');", "verified_output": "{\"id\":\"JAH-REC-1\",\"record\":{\"title\":\"alpha\",\"id\":\"JAH-REC-1\"}}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Record Validator Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Record Creator", "Duplicate Detector", "Result Verification Tool"], "sibling_edition": "tool-record-validator-signature"}}
{"id": "JAH-TOOL-RECORDVA-000004", "slug": "tool-record-validator", "title": "Record Validator \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Validate 50 database records: find the 3 with missing titles and the 1 with a count mismatch, certify the other 46.", "capabilities": ["Schema conformance checking", "Type and format validation", "Cross-field consistency rules", "Uniqueness checks on key fields", "Clean-record certification"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const db=new Map([['a',{v:1}],['b',{v:2}],['c',{v:3}]]);const q=[...db.entries()].filter(([k,r])=>r.v>1).map(([k])=>k);J({matched:q});assert(q.length===2,'query');", "verified_output": "{\"matched\":[\"b\",\"c\"]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Record Validator Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Record Creator", "Duplicate Detector", "Result Verification Tool"], "sibling_edition": "tool-record-validator-signature"}}
{"id": "JAH-TOOL-RECORDVA-000005", "slug": "tool-record-validator", "title": "Record Validator \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Validates structure and consistency, not factual truth; custom rules must be stated explicitly.", "capabilities": ["Schema conformance checking", "Type and format validation", "Cross-field consistency rules", "Uniqueness checks on key fields", "Clean-record certification"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const db=new Map();function create(r){if([...db.values()].some(x=>x.key===r.key))return {error:'duplicate'};db.set(r.key,r);return {ok:true};}create({key:'k1'});const r2=create({key:'k1'});J(r2);assert(r2.error==='duplicate','unique');", "verified_output": "{\"error\":\"duplicate\"}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Record Validator Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Record Creator", "Duplicate Detector", "Result Verification Tool"], "sibling_edition": "tool-record-validator-signature"}}
