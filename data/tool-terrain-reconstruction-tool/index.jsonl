{"id": "JAH-TOOL-TERRAINR-000001", "slug": "tool-terrain-reconstruction-tool", "title": "Terrain Reconstruction Tool \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Builds terrain models from supported elevation or remote-sensing data. The Terrain Reconstruction Tool interpolates elevation samples into a continuous terrain surface: inverse-distance weighting over a grid, slope and aspect derivation, and contour extraction. It reports interpolation error at sample points so users see where the surface is trustworthy. A terrain-modeling method for mapping study. Capability specification and design target: this database describes what the tool must do, not a claim of implementation or deployment. Defensive and engineering content only \u2014 no weapon-targeting or attack-execution content.", "capabilities": ["Gridded surface interpolation", "Slope and aspect derivation", "Contour-line extraction", "Interpolation-error reporting", "Sample-density mapping"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Terrain Reconstruction Tool\",\"capabilities\":[\"Gridded surface interpolation\",\"Slope and aspect derivation\",\"Contour-line extraction\",\"Interpolation-error reporting\",\"Sample-density mapping\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "comp