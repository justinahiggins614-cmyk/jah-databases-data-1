{"id": "JAH-TOOTH-000008", "slug": "toothpick-structures", "title": "Toothpick Structure — Toothpick Glue and Joint Guide", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure record", "ladder_rank": 15, "body": "Public edition. Public build reference. Strong toothpick joints: use wood glue (not school glue), apply a small drop, hold or clamp 60 seconds, and let cure 24 hours for load-bearing builds. Laminate 2-3 picks for chords and beams — a laminated beam is many times stiffer. Sand joints lightly for better glue grip. Rule: glued joints beat marshmallow joints for anything that must hold weight.", "capabilities": ["Choose wood glue", "Clamp 60 seconds", "Cure 24 hours", "Laminate chords", "Sand for grip"], "demo": {"language": "javascript", "title": "Toothpick glue cure scheduler", "code": "const m=C.joints*C.clamp_sec_each/60;assert(m===C.expected_min,'minutes');J({clamping_minutes:m});", "verified_output": "{\"clamping_minutes\":40}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Toothpick Structures Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Toothpick Cube", "Toothpick Bridge Truss", "Toothpick Pyramid"], "sibling_edition": "toothpick-structures-signature"}}
