{"id": "JAH-COOKWARE-000001", "slug": "cookware-public", "title": "Skillets and Frying Pans", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "cookware record", "ladder_rank": 1, "body": "The skillet is the most-used pan in the kitchen: shallow sloped sides for easy turning. Cast iron skillets sear beautifully and last generations; keep them seasoned with thin oil layers baked on. Stainless skillets with an aluminum core heat evenly and go from stovetop to oven. Nonstick skillets need only medium heat and no metal utensils. A 10- or 12-inch skillet handles most daily cooking.", "capabilities": ["Compare cast iron, stainless, and nonstick skillets", "Explain cast-iron seasoning", "Explain why nonstick needs medium heat", "Give standard skillet sizes", "Explain stovetop-to-oven use"], "demo": {"language": "javascript", "title": "Skillet surface area", "code": "const d=12,r=d/2;J({sq_in:+(Math.PI*r*r).toFixed(0)});assert(Math.PI*r*r>110,'skillet');", "verified_output": "{\"sq_in\":113}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Cookware Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Saucepans", "Stockpots", "Dutch Ovens"], "sibling_edition": "cookware-public-signature"}}
{"id": "JAH-COOKWARE-000002", "slug": "cookware-public", "title": "Saucepans", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "cookware record", "ladder_rank": 2, "body": "A saucepan is a deep, straight-sided pan with a long handle and lid, made for sauces, grains, and reheating. Heavy bottoms prevent scorching; look for encapsulated aluminum or copper cores. Sizes run 1 to 4 quarts — a 2-quart saucepan is the everyday workhorse. Stir frequently when cooking sauces to prevent sticking and burning. Lids trap steam and speed cooking.", "capabilities": ["Describe saucepan shape and purpose", "Explain heavy-bottom construction", "List common saucepan sizes", "Explain stirring for sauces", "Explain lid function"], "demo": {"language": "javascript", "title": "Saucepan volume", "code": "const d=8,h=4.5,r=d/2;const qt=(Math.PI*r*r*h/57.75);J({quarts:+qt.toFixed(1)});assert(qt>3.5&&qt<4.5,'saucepan');", "verified_output": "{\"quarts\":3.9}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Cookware Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Skillets and Frying Pans", "Stockpots", "Dutch Ovens"], "sibling_edition": "cookware-public-signature"}}
{"id": "JAH-COOKWARE-000003", "slug": "cookware-public", "title": "Stockpots", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "cookware record", "ladder_rank": 3, "body": "A stockpot is a tall, large pot — 8 to 20 quarts — for stocks, soups, pasta, and canning. Tall sides slow evaporation, which is what you want for long-simmered stock. A pasta insert or steamer basket turns a stockpot into a multi-cooker. Bring to a boil, then reduce to the barest simmer for clear stock. Never fill past two-thirds; boiling liquids surge.", "capabilities": ["Give stockpot size range", "Explain tall sides for stock", "Describe insert accessories", "Explain the simmer-not-boil rule", "Explain the two-thirds fill rule"], "demo": {"language": "javascript", "title": "Stock yield", "code": "const water=12;const h=8;const yield_qt=water*(1-0.2);J({yield_qt});assert(Math.abs(yield_qt-9.6)<0.01,'stock');", "verified_output": "{\"yield_qt\":9.600000000000001}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Cookware Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Skillets and Frying Pans", "Saucepans", "Dutch Ovens"], "sibling_edition": "cookware-public-signature"}}
{"id": "JAH-COOKWARE-000004", "slug": "cookware-public", "title": "Dutch Ovens", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "cookware record", "ladder_rank": 4, "body": "A Dutch oven is a heavy lidded pot — usually enameled cast iron — for braising, baking bread, and deep frying. The heavy lid traps moisture, basting food as it cooks. It goes from stovetop to a 450-degree oven without complaint. Enameled interiors need no seasoning and clean easily; avoid metal utensils on the enamel. A 5.5-quart Dutch oven suits most families.", "capabilities": ["Describe Dutch oven construction", "Explain the self-basting lid", "Explain stovetop-to-oven use", "Compare enameled and raw cast iron", "Give the standard family size"], "demo": {"language": "javascript", "title": "Braise liquid ratio", "code": "const meat=3,qt=5.5;J({liquid_cups:4});assert(4<qt*2,'braise');", "verified_output": "{\"liquid_cups\":4}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Cookware Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Skillets and Frying Pans", "Saucepans", "Stockpots"], "sibling_edition": "cookware-public-signature"}}
{"id": "JAH-COOKWARE-000005", "slug": "cookware-public", "title": "Woks", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "cookware record", "ladder_rank": 5, "body": "A wok's round bottom and sloped sides create heat zones: fierce heat at the bottom, gentler heat up the sides. Carbon steel woks season like cast iron and are the traditional choice. Stir-frying needs the wok smoking hot before oil goes in. A flat-bottomed wok works on electric stoves; round bottoms need a wok ring or gas burner. Keep food moving — the technique is in the toss.", "capabilities": ["Explain wok heat zones", "Compare carbon steel and nonstick woks", "Explain preheating before oil", "Describe flat vs round bottoms", "Explain the tossing technique"], "demo": {"language": "javascript", "title": "Wok capacity", "code": "const d=14;J({diameter_in:d});assert(d>=12&&d<=16,'wok');", "verified_output": "{\"diameter_in\":14}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Cookware Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Skillets and Frying Pans", "Saucepans", "Stockpots"], "sibling_edition": "cookware-public-signature"}}
{"id": "JAH-COOKWARE-000006", "slug": "cookware-public", "title": "Griddles", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "cookware record", "ladder_rank": 6, "body": "A griddle is a large flat cooking surface for pancakes, bacon, and grilled sandwiches. Stovetop griddles span two burners; electric griddles have their own thermostat. Cast iron griddles need seasoning; nonstick griddles need gentle tools. Preheat evenly — hot spots are the main griddle complaint. A light oil film, wiped almost dry, gives the best browning.", "capabilities": ["Describe griddle types", "Explain two-burner spanning", "Explain preheating for even heat", "Describe the wiped-dry oil film", "List classic griddle foods"], "demo": {"language": "javascript", "title": "Griddle area", "code": "const w=20,d=10;J({sq_in:w*d});assert(w*d===200,'griddle');", "verified_output": "{\"sq_in\":200}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Cookware Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Skillets and Frying Pans", "Saucepans", "Stockpots"], "sibling_edition": "cookware-public-signature"}}
{"id": "JAH-COOKWARE-000007", "slug": "cookware-public", "title": "Roasting Pans", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "cookware record", "ladder_rank": 7, "body": "A roasting pan is a large, shallow, heavy pan with a rack for roasts and turkeys. The rack lifts meat out of its drippings so it roasts instead of steaming. Heavy-gauge pans won't warp at high heat. Deglaze the pan after roasting — those browned bits are the base of great gravy. Choose a pan 2 to 3 inches larger than the roast on each side.", "capabilities": ["Explain the roasting rack's purpose", "Explain heavy-gauge warp resistance", "Describe deglazing for gravy", "Give pan-sizing rules", "List roasting pan uses"], "demo": {"language": "javascript", "title": "Pan sizing", "code": "const roast=14;J({pan_in:roast+5});assert(roast+5===19,'roastpan');", "verified_output": "{\"pan_in\":19}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Cookware Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Skillets and Frying Pans", "Saucepans", "Stockpots"], "sibling_edition": "cookware-public-signature"}}
{"id": "JAH-COOKWARE-000008", "slug": "cookware-public", "title": "Cookware Materials Guide", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "cookware record", "ladder_rank": 8, "body": "Cookware materials trade heat behavior, weight, and care. Stainless steel is durable and nonreactive but a poor heat conductor alone — look for clad layers. Cast iron holds heat superbly and lasts forever but is heavy and reactive with acids until well seasoned. Copper heats fastest and most evenly but needs lining and polishing. Aluminum is light and conductive; hard-anodized aluminum resists scratching. Match the material to the job: sear in cast iron, simmer sauces in clad stainless, fry eggs in nonstick.", "capabilities": ["Compare the five main cookware materials", "Explain clad construction", "Explain cast-iron reactivity", "Explain copper's trade-offs", "Match materials to cooking tasks"], "demo": {"language": "javascript", "title": "Heat conductivity ranking", "code": "const k={copper:400,aluminum:235,castiron:52,stainless:16};const best=Object.entries(k).sort((a,b)=>b[1]-a[1])[0];J({best:best[0]});assert(best[0]==='copper','conduct');", "verified_output": "{\"best\":\"copper\"}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Cookware Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Skillets and Frying Pans", "Saucepans", "Stockpots"], "sibling_edition": "cookware-public-signature"}}
