{"id": "JAH-TOOL-RECORDCR-000007", "slug": "tool-record-creator", "title": "Record Creator \u2014 Advanced pattern", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 11, "body": "Public edition. Public tool knowledge, fact-checked reference. Advanced use of Record Creator composes it with neighboring tools: chain its output into the next tool, add verification checkpoints, and automate the sequence once the manual path is proven.", "capabilities": ["Validated insert with schema checking", "Deterministic ID assignment", "Uniqueness enforcement on key fields", "Batch creation with per-record results", "Return of the created record with ID"], "demo": {"language": "javascript", "title": "Advanced pattern: backup and restore with checksums", "code": "const db=[{id:1,t:'a'},{id:2,t:'b'}];const sum=s=>[...s].reduce((a,c)=>(a*31+c.charCodeAt(0))>>>0,0);const manifest=db.map(r=>({id:r.id,cs:sum(JSON.stringify(r))}));const restored=JSON.parse(JSON.stringify(db));const ok=restored.every((r,i)=>sum(JSON.stringify(r))===manifest[i].cs);J({records:restored.length,verified:ok});assert(ok,'backup');", "verified_output": "{\"records\":2,\"verified\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Record Creator Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Record Updater", "Record Validator", "Duplicate Detector"], "sibling_edition": "tool-record-creator-signature"}}
