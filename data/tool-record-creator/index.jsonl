{"id": "JAH-TOOL-RECORDCR-000001", "slug": "tool-record-creator", "title": "Record Creator \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Adds new records to a database, validated and complete. The Record Creator inserts new records into a database with full validation: required fields present, types correct, and identifiers unique before the write commits. It assigns deterministic IDs from the database's ID scheme and returns the created record with its new ID. Nothing half-formed is ever stored.", "capabilities": ["Validated insert with schema checking", "Deterministic ID assignment", "Uniqueness enforcement on key fields", "Batch creation with per-record results", "Return of the created record with ID"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Record Creator\",\"capabilities\":[\"Validated insert with schema checking\",\"Deterministic ID assignment\",\"Uniqueness enforcement on key fields\",\"Batch creation with per-record results\",\"Return of the created record with ID\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Record Creator Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Record Updater", "Record Validator", "Duplicate Detector"], "sibling_edition": "tool-record-creator-signature"}}
{"id": "JAH-TOOL-RECORDCR-000002", "slug": "tool-record-creator", "title": "Record Creator \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Database, record data, ID scheme. Outputs: Created record(s) with assigned IDs and validation report.", "capabilities": ["Validated insert with schema checking", "Deterministic ID assignment", "Uniqueness enforcement on key fields", "Batch creation with per-record results", "Return of the created record with ID"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const schema={required:['title'],types:{title:'string'}};const rec={title:'x'};const missing=schema.required.filter(k=>!(k in rec));J({missing});assert(missing.length===0,'contract');", "verified_output": "{\"missing\":[]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Record Creator Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Record Updater", "Record Validator", "Duplicate Detector"], "sibling_edition": "tool-record-creator-signature"}}
{"id": "JAH-TOOL-RECORDCR-000003", "slug": "tool-record-creator", "title": "Record Creator \u2014 Core capabilities", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 5, "body": "Public edition. Public tool knowledge, fact-checked reference. Capabilities: Validated insert with schema checking; Deterministic ID assignment; Uniqueness enforcement on key fields; Batch creation with per-record results; Return of the created record with ID.", "capabilities": ["Validated insert with schema checking", "Deterministic ID assignment", "Uniqueness enforcement on key fields", "Batch creation with per-record results", "Return of the created record with ID"], "demo": {"language": "javascript", "title": "Core operation executed", "code": "const db=new Map();let n=0;function create(r){if(!r.title)throw new Error('title required');const id='JAH-REC-'+(++n);db.set(id,{...r,id});return id;}const id=create({title:'alpha'});J({id,record:db.get(id)});assert(db.get(id).title==='alpha','create');", "verified_output": "{\"id\":\"JAH-REC-1\",\"record\":{\"title\":\"alpha\",\"id\":\"JAH-REC-1\"}}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Record Creator Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Record Updater", "Record Validator", "Duplicate Detector"], "sibling_edition": "tool-record-creator-signature"}}
{"id": "JAH-TOOL-RECORDCR-000004", "slug": "tool-record-creator", "title": "Record Creator \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Add 3 tool records to the tools database: validate each, assign IDs JAH-TOOL-000101..103, and return them with the validation report.", "capabilities": ["Validated insert with schema checking", "Deterministic ID assignment", "Uniqueness enforcement on key fields", "Batch creation with per-record results", "Return of the created record with ID"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const db=new Map([['a',{v:1}],['b',{v:2}],['c',{v:3}]]);const q=[...db.entries()].filter(([k,r])=>r.v>1).map(([k])=>k);J({matched:q});assert(q.length===2,'query');", "verified_output": "{\"matched\":[\"b\",\"c\"]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Record Creator Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Record Updater", "Record Validator", "Duplicate Detector"], "sibling_edition": "tool-record-creator-signature"}}
{"id": "JAH-TOOL-RECORDCR-000005", "slug": "tool-record-creator", "title": "Record Creator \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Refuses records missing required fields; duplicate keys are rejected, never silently merged.", "capabilities": ["Validated insert with schema checking", "Deterministic ID assignment", "Uniqueness enforcement on key fields", "Batch creation with per-record results", "Return of the created record with ID"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const db=new Map();function create(r){if([...db.values()].some(x=>x.key===r.key))return {error:'duplicate'};db.set(r.key,r);return {ok:true};}create({key:'k1'});const r2=create({key:'k1'});J(r2);assert(r2.error==='duplicate','unique');", "verified_output": "{\"error\":\"duplicate\"}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Record Creator Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Record Updater", "Record Validator", "Duplicate Detector"], "sibling_edition": "tool-record-creator-signature"}}
