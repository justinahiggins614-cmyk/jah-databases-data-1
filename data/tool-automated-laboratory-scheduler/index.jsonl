{"id": "JAH-TOOL-AUTOMATED-000004", "slug": "tool-automated-laboratory-scheduler", "title": "Automated Laboratory Scheduler \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Schedule 9 experiments on 3 instruments: no overlaps, the centrifuge contention resolved by shifting 2 runs, downtime plan included.", "capabilities": ["Instrument-availability modeling", "Sample-readiness tracking", "Dependency-aware scheduling", "Contention flagging", "Rescheduling on disruption"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const terms=[['3x^3',3,3],['-2x',-2,1],['5',5,0]];const deriv=terms.map(([t,c,p])=>p===0?null:{c:c*p,p:p-1}).filter(Boolean);const s=deriv.map(d=>`${d.c}x^${d.p}`).join(' + ');J({derivative:s});assert(s==='9x^2 + -2x^0','symbolic');", "verified_output": "{\"derivative\":\"9x^2 + -2x^0\"}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Automated Laboratory Scheduler Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Experiment Design Optimizer", "Scheduler", "Task Queue Manager"], "sibling_edition": "tool-automated-laboratory-scheduler-signature"}}
