{"id": "JAH-TOOL-CODEEXEC-000004", "slug": "tool-code-executor", "title": "Code Executor \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Run a sorting snippet with a 5-second limit: return its printed output, exit code 0, and 12 ms runtime.", "capabilities": ["Time and memory-bounded execution", "Captured stdout, stderr, exit code", "Restricted filesystem and network access", "Multi-language runtimes", "Timeout and crash reporting"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const src='function add(a,b){return a+b}';const fns=[...src.matchAll(/function\\s+(\\w+)\\s*\\(([^)]*)\\)/g)].map(m=>({name:m[1],params:m[2].split(',').map(s=>s.trim()).filter(Boolean)}));const risks=[/eval\\s*\\(/.test(src)?'eval':null,/password\\s*=\\s*['\"]/.test(src)?'hardcoded-secret':null].filter(Boolean);J({functions:fns,risks});assert(fns[0].name==='add'&&risks.length===0,'read');", "verified_output": "{\"functions\":[{\"name\":\"add\",\"params\":[\"a\",\"b\"]}],\"risks\":[]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Code Executor Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Debugger", "Test Runner", "Secure Execution Sandbox"], "sibling_edition": "tool-code-executor-signature"}}
{"id": "JAH-TOOL-CODEEXEC-000005", "slug": "tool-code-executor", "title": "Code Executor \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Sandboxed by design \u2014 no arbitrary system access; infinite loops are killed at the timeout, reported as timeouts.", "capabilities": ["Time and memory-bounded execution", "Captured stdout, stderr, exit code", "Restricted filesystem and network access", "Multi-language runtimes", "Timeout and crash reporting"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const vm=require('vm');let blocked=false;try{vm.runInContext('process.exit(1)',vm.createContext({}),{timeout:1000});}catch(e){blocked=/not defined/.test(e.message);}J({blocked});assert(blocked,'sandbox');", "verified_output": "{\"blocked\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Code Executor Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Debugger", "Test Runner", "Secure Execution Sandbox"], "sibling_edition": "tool-code-executor-signature"}}
