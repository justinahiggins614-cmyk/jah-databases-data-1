{"id": "JAH-TOOL-FILECOMP-000001", "slug": "tool-file-compression-tool", "title": "File Compression Tool \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Compresses files to save storage space, with integrity checks. The File Compression Tool shrinks files and folders using standard compression formats to save storage and transfer time. It supports common archive formats, reports the compression ratio achieved, and verifies archive integrity after writing. Decompression restores the exact original bytes.", "capabilities": ["Compress single files and whole directories", "Multiple format support (ZIP, GZIP, TAR.GZ)", "Compression-ratio reporting per archive", "Integrity verification of written archives", "Decompression that restores byte-identical originals"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"File Compression Tool\",\"capabilities\":[\"Compress single files and whole directories\",\"Multiple format support (ZIP, GZIP, TAR.GZ)\",\"Compression-ratio reporting per archive\",\"Integrity verification of written archives\",\"Decompression that restores byte-identical originals\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_wh