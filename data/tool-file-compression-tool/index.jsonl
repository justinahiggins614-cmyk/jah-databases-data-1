{"id": "JAH-TOOL-FILECOMP-000005", "slug": "tool-file-compression-tool", "title": "File Compression Tool \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Already-compressed media gains little; refuses to create archives outside authorized directories.", "capabilities": ["Compress single files and whole directories", "Multiple format support (ZIP, GZIP, TAR.GZ)", "Compression-ratio reporting per archive", "Integrity verification of written archives", "Decompression that restores byte-identical originals"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const ALLOWED=[TMP];function allowed(p){return ALLOWED.some(a=>path.resolve(p).startsWith(a));}const evil='/etc/passwd';J({path:evil,allowed:allowed(evil)});assert(!allowed(evil),'sandbox');", "verified_output": "{\"path\":\"/etc/passwd\",\"allowed\":false}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH File Compression Tool Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Archive Extractor", "File Writer", "Database Backup and Restore Tool"], "sibling_edition": "tool-file-compression-tool-signature"}}
