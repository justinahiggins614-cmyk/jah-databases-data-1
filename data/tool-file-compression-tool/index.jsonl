{"id": "JAH-TOOL-FILECOMP-000002", "slug": "tool-file-compression-tool", "title": "File Compression Tool \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Source path(s), target archive path, format, compression level. Outputs: Compressed archive plus ratio and integrity report.", "capabilities": ["Compress single files and whole directories", "Multiple format support (ZIP, GZIP, TAR.GZ)", "Compression-ratio reporting per archive", "Integrity verification of written archives", "Decompression that restores byte-identical originals"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const req=['target_path','content','encoding','mode'];const sample={target_path:TMP+'/notes.txt',content:'hello',encoding:'utf-8',mode:'create'};const missing=req.filter(k=>!(k in sample));J({contract:'write',missing});assert(missing.length===0,'contract');", "verified_output": "{\"contract\":\"write\",\"missing\":[]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH File Compression Tool Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Archive Extractor", "File Writer", "Database Backup and Restore Tool"], "sibling_edition": "tool-file-compression-tool-signature"}}
