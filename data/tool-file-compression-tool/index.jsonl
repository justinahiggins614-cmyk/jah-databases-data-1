{"id": "JAH-TOOL-FILECOMP-000004", "slug": "tool-file-compression-tool", "title": "File Compression Tool \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Compress a 10 MB log directory to ZIP at default level, report the ratio, then decompress to a temp folder and diff against the original.", "capabilities": ["Compress single files and whole directories", "Multiple format support (ZIP, GZIP, TAR.GZ)", "Compression-ratio reporting per archive", "Integrity verification of written archives", "Decompression that restores byte-identical originals"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const src=path.join(TMP,'src');fs.mkdirSync(src);for(let i=0;i<3;i++)fs.writeFileSync(path.join(src,'f'+i+'.txt'),'data'+i);const dst=path.join(TMP,'dst');fs.mkdirSync(dst);const files=fs.readdirSync(src);files.forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dst,f)));const ok=files.every(f=>fs.readFileSync(path.join(dst,f),'utf8')===fs.readFileSync(path.join(src,f),'utf8'));J({copied:files.length,verified:ok});assert(ok,'verify');", "verified_output": "{\"copied\":3,\"verified\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH File Compression Tool Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Archive Extractor", "File Writer", "Database Backup an