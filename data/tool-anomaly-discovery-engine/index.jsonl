{"id": "JAH-TOOL-ANOMALYD-000001", "slug": "tool-anomaly-discovery-engine", "title": "Anomaly Discovery Engine \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Finds unusual patterns in scientific observations. The Anomaly Discovery Engine scans datasets for the unusual: statistical outliers, distribution shifts, and novel clusters that don't match known patterns. It ranks findings by surprise score, shows the context around each anomaly, and separates 'interesting' from 'probably noise' with explicit criteria. A data-exploration aid for researchers. Capability specification and design target: this database describes what the tool must do, not a claim of implementation or deployment. Defensive and engineering content only \u2014 no weapon-targeting or attack-execution content.", "capabilities": ["Outlier detection with scoring", "Distribution-shift detection", "Novel-cluster flagging", "Context display per anomaly", "Noise-vs-signal criteria"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Anomaly Discovery Engine\",\"capabilities\":[\"Outlier detection with scoring\",\"Distribution-shift detection\",\"Novel-cluster flagging\",\"Context display per anomaly\",\"Noise-vs-signal criteria\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "m