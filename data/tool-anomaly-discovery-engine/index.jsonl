{"id": "JAH-TOOL-ANOMALYD-000003", "slug": "tool-anomaly-discovery-engine", "title": "Anomaly Discovery Engine \u2014 Core capabilities", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 5, "body": "Public edition. Public tool knowledge, fact-checked reference. Capabilities: Outlier detection with scoring; Distribution-shift detection; Novel-cluster flagging; Context display per anomaly; Noise-vs-signal criteria.", "capabilities": ["Outlier detection with scoring", "Distribution-shift detection", "Novel-cluster flagging", "Context display per anomaly", "Noise-vs-signal criteria"], "demo": {"language": "javascript", "title": "Core operation executed", "code": "const xs=[10,11,9,10,12,10,11,45,10,9];const mean=xs.reduce((a,b)=>a+b)/xs.length;const sd=Math.sqrt(xs.reduce((a,b)=>a+(b-mean)**2,0)/xs.length);const flags=xs.map((x,i)=>({i,z:+((x-mean)/sd).toFixed(1)})).filter(o=>Math.abs(o.z)>2.5);J({mean:+mean.toFixed(1),flags});assert(flags.length===1&&flags[0].i===7,'anomaly');", "verified_output": "{\"mean\":13.7,\"flags\":[{\"i\":7,\"z\":3}]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Anomaly Discovery Engine Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Telemetry Intelligence Analyzer", "Scientific Model Discovery Tool", "Data Exporter"], "sibling_edition": "tool-anomaly-discovery-engine-signature"}}
{"id": "JAH-TOOL-ANOMALYD-000004", "slug": "tool-anomaly-discovery-engine", "title": "Anomaly Discovery Engine \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Scan 5,000 sensor readings: surface 7 outliers, rank the 4.2-sigma spike first, mark 2 as probable noise with reasons.", "capabilities": ["Outlier detection with scoring", "Distribution-shift detection", "Novel-cluster flagging", "Context display per anomaly", "Noise-vs-signal criteria"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const terms=[['3x^3',3,3],['-2x',-2,1],['5',5,0]];const deriv=terms.map(([t,c,p])=>p===0?null:{c:c*p,p:p-1}).filter(Boolean);const s=deriv.map(d=>`${d.c}x^${d.p}`).join(' + ');J({derivative:s});assert(s==='9x^2 + -2x^0','symbolic');", "verified_output": "{\"derivative\":\"9x^2 + -2x^0\"}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Anomaly Discovery Engine Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Telemetry Intelligence Analyzer", "Scientific Model Discovery Tool", "Data Exporter"], "sibling_edition": "tool-anomaly-discovery-engine-signature"}}
