{"id": "JAH-TBLOCK-000006", "slug": "toy-building-block-structures", "title": "Toy Block Structure — Toy Block Lighthouse", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure record", "ladder_rank": 10, "body": "Public edition. Public build reference. A tapering lighthouse. Materials: 2x4 (x16), 2x2 (x24), 1x1 (x8), clear/trans bricks for the lamp (x4). Steps: (1) build the 6x6 base; (2) taper to 4x4 over 8 courses; (3) set the lamp room of clear bricks; (4) cone the top; (5) check it stands on a table edge without wobble. Tip: taper slowly — a sudden step-in is a weak joint.", "capabilities": ["Build the wide base", "Taper over eight courses", "Set the lamp room", "Cone the top", "Check the stance"], "demo": {"language": "javascript", "title": "Block lighthouse taper planner", "code": "const s=(C.base-C.top)/C.courses;assert(Math.abs(s-C.expected_step)<0.01,'taper');J({taper_per_course:s});", "verified_output": "{\"taper_per_course\":0.25}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Toy Block Structures Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Toy Block Arch Bridge", "Toy Block Castle", "Toy Block Garage"], "sibling_edition": "toy-building-block-structures-signature"}}
