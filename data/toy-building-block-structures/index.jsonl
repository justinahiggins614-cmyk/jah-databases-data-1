{"id": "JAH-TBLOCK-000008", "slug": "toy-building-block-structures", "title": "Toy Block Structure — Toy Block Balancing: Stacking Rules", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure record", "ladder_rank": 15, "body": "Public edition. Public build reference. The physics of stacking blocks: (1) the widest, heaviest blocks go lowest; (2) offset joints every course; (3) keep the center of mass over the base — test by sighting down the tower; (4) tapering beats stepping for tall builds; (5) arches carry spans, flat beams do not. A tower falls when its lean moves the center of mass past the base edge — build, nudge, and learn where that edge is. Tip: if it wobbles, widen the base, not the top.", "capabilities": ["Load heavy blocks low", "Offset every joint", "Center mass over base", "Taper tall builds", "Test the lean limit"], "demo": {"language": "javascript", "title": "Block tower stability estimator", "code": "const r=C.height/C.base;assert(Math.abs(r-C.expected_ratio)<0.01,'ratio');J({height_to_base:Math.round(r*100)/100});", "verified_output": "{\"height_to_base\":3.33}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Toy Block Structures Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Toy Block Arch Bridge", "Toy Block Castle", "Toy Block Garage"], "sibling_edition": "toy-building-block-structures-signature"}}
