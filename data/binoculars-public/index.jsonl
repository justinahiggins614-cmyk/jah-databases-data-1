{"id": "JAH-BINOC-000001", "slug": "binoculars-public", "title": "Binocular Anatomy", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "binocular record", "ladder_rank": 1, "body": "Binoculars are two telescopes joined: objective lenses gather light, prisms correct the image orientation, and eyepieces magnify. The objective lens diameter (in millimeters) sets light-gathering power. Eyepieces set magnification. A focus wheel moves both sides together; the diopter ring fine-tunes one eye. Porro-prism models have the classic wide zigzag shape; roof-prism models are straight and compact. Fully multi-coated lenses transmit the most light.", "capabilities": ["Name the three optical stages", "Explain objective lens function", "Explain the diopter adjustment", "Distinguish Porro and roof shapes", "Explain lens coatings"], "demo": {"language": "javascript", "title": "Light gathering ratio", "code": "const d1=50,d2=42;J({ratio:+((d1/d2)**2).toFixed(2)});assert((d1/d2)**2>1.4,'lightgather');", "verified_output": "{\"ratio\":1.42}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Binoculars Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Prism Types — Porro vs Roof", "Reading Binocular Numbers", "Choosing Binoculars"], "sibling_edition": "binoculars-public-signature"}}
{"id": "JAH-BINOC-000002", "slug": "binoculars-public", "title": "Prism Types — Porro vs Roof", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "binocular record", "ladder_rank": 2, "body": "Porro prisms offset the light path, giving the wide classic binocular shape and excellent depth perception. Roof prisms fold the path straight, making slim, rugged, waterproof-friendly bodies. Porro models usually cost less for equal optical quality. Roof prisms need phase-correction coatings to match Porro contrast. Choose Porro for value, roof for compactness and toughness.", "capabilities": ["Explain Porro prism light path", "Explain roof prism folding", "Compare costs at equal quality", "Explain phase-correction coatings", "Give the value-vs-compactness rule"], "demo": {"language": "javascript", "title": "Prism offset", "code": "const porro={offset_mm:60},roof={offset_mm:0};J({porro_offset:porro.offset_mm,roof_offset:roof.offset_mm});assert(porro.offset_mm>roof.offset_mm,'prism');", "verified_output": "{\"porro_offset\":60,\"roof_offset\":0}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Binoculars Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Binocular Anatomy", "Reading Binocular Numbers", "Choosing Binoculars"], "sibling_edition": "binoculars-public-signature"}}
{"id": "JAH-BINOC-000003", "slug": "binoculars-public", "title": "Reading Binocular Numbers", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "binocular record", "ladder_rank": 3, "body": "Binoculars are sold as magnification x objective diameter, e.g. 8x42. 8x42 means 8 times magnification with 42mm objectives — the classic all-around choice. Higher magnification narrows the field of view and magnifies hand shake. Exit pupil equals objective diameter divided by magnification: 42/8 = 5.25mm, plenty for daylight and dusk. For astronomy, 10x50 or 15x70 gather more light but need a tripod.", "capabilities": ["Decode 8x42 notation", "Explain the magnification/shake trade-off", "Compute exit pupil", "Recommend astronomy sizes", "Explain field-of-view narrowing"], "demo": {"language": "javascript", "title": "Exit pupil", "code": "const mag=8,obj=42;J({exit_pupil:mm=>(obj/mag)});const ep=obj/mag;J({exit_pupil_mm:ep});assert(ep===5.25,'exitpupil');", "verified_output": "{}\n{\"exit_pupil_mm\":5.25}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Binoculars Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Binocular Anatomy", "Prism Types — Porro vs Roof", "Choosing Binoculars"], "sibling_edition": "binoculars-public-signature"}}
{"id": "JAH-BINOC-000004", "slug": "binoculars-public", "title": "Choosing Binoculars", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "binocular record", "ladder_rank": 4, "body": "Match binoculars to the job: 8x42 for birding and general use, 10x42 for open country, compact 8x25 for travel. Try before buying — eye relief matters for glasses wearers (14mm or more). Check close focus distance for butterflies and insects. Waterproof and fog-proof (nitrogen-purged) models survive weather. Weight matters on long hikes: compacts save half a pound or more.", "capabilities": ["Match sizes to uses", "Explain eye relief for glasses", "Explain close-focus specs", "Define waterproof/fog-proof", "Explain weight trade-offs"], "demo": {"language": "javascript", "title": "Weight saving", "code": "const full=28,compact=12;J({saved_oz:full-compact});assert(full-compact===16,'binoweight');", "verified_output": "{\"saved_oz\":16}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Binoculars Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Binocular Anatomy", "Prism Types — Porro vs Roof", "Reading Binocular Numbers"], "sibling_edition": "binoculars-public-signature"}}
{"id": "JAH-BINOC-000005", "slug": "binoculars-public", "title": "Binoculars for Astronomy", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "binocular record", "ladder_rank": 5, "body": "Binoculars are the best first astronomy instrument: wide views, two eyes, no setup. 7x50 and 10x50 models show the Moon's craters, Jupiter's moons, and star clusters. Above 10x magnification, mount them on a tripod — shake ruins the view. Dark skies matter more than bigger lenses. A reclining chair plus binoculars is a complete deep-sky setup.", "capabilities": ["Explain why binoculars suit beginners", "List 7x50/10x50 targets", "Explain the tripod rule", "Explain dark-sky importance", "Describe the reclining-chair setup"], "demo": {"language": "javascript", "title": "Jupiter moons visible", "code": "const moons=['Io','Europa','Ganymede','Callisto'];J({count:moons.length});assert(moons.length===4,'jovian');", "verified_output": "{\"count\":4}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Binoculars Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Binocular Anatomy", "Prism Types — Porro vs Roof", "Reading Binocular Numbers"], "sibling_edition": "binoculars-public-signature"}}
{"id": "JAH-BINOC-000006", "slug": "binoculars-public", "title": "Binocular Care and Maintenance", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "binocular record", "ladder_rank": 6, "body": "Blow or brush dust off lenses before wiping — grit scratches coatings. Use a microfiber cloth and lens fluid, wiping in circles from center outward. Store binoculars in their case in a dry place; silica gel fights fungus in humid climates. Never leave them in a hot car — heat damages seals and lubricants. Collimation (alignment) is a factory job; if double images appear, send them in.", "capabilities": ["Explain dust-first cleaning", "Describe the circular wipe method", "Explain silica-gel storage", "Explain hot-car damage", "Explain collimation repair"], "demo": {"language": "javascript", "title": "Cleaning order", "code": "const steps=['blow','brush','wipe'];J({steps});assert(steps[0]==='blow','binoCare');", "verified_output": "{\"steps\":[\"blow\",\"brush\",\"wipe\"]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Binoculars Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Binocular Anatomy", "Prism Types — Porro vs Roof", "Reading Binocular Numbers"], "sibling_edition": "binoculars-public-signature"}}
{"id": "JAH-BINOC-000007", "slug": "binoculars-public", "title": "Image-Stabilized Binoculars", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "binocular record", "ladder_rank": 7, "body": "Image-stabilized binoculars use gyros or electronics to cancel hand shake. They let you use 12x to 18x magnification handheld — impossible with standard binoculars. Batteries power the stabilizer; most run on AA cells. They cost several times more than standard models and weigh more. Best for boat use, long-distance birding, and anyone with unsteady hands.", "capabilities": ["Explain stabilization technology", "Give handheld magnification limits", "Describe battery needs", "Explain cost and weight penalties", "List best use cases"], "demo": {"language": "javascript", "title": "Effective magnification gain", "code": "const standard=10,stabilized=16;J({gain_pct:((stabilized-standard)/standard*100).toFixed(0)});assert(stabilized>standard,'isgain');", "verified_output": "{\"gain_pct\":\"60\"}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Binoculars Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Binocular Anatomy", "Prism Types — Porro vs Roof", "Reading Binocular Numbers"], "sibling_edition": "binoculars-public-signature"}}
{"id": "JAH-BINOC-000008", "slug": "binoculars-public", "title": "Monoculars and Spotting Scopes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "binocular record", "ladder_rank": 8, "body": "A monocular is half a binocular: one 8x or 10x tube, pocket-sized, for quick looks. Spotting scopes are single high-power telescopes (20-60x) on tripods for distant detail. Birders use spotting scopes to identify far waterfowl; target shooters spot bullet holes. Angled eyepieces suit shared use and looking up; straight eyepieces aim faster. Quality matters more at high magnification — cheap spotters disappoint.", "capabilities": ["Define a monocular", "Describe spotting-scope magnification", "List spotting-scope uses", "Compare angled and straight eyepieces", "Explain quality at high power"], "demo": {"language": "javascript", "title": "Zoom range", "code": "const low=20,high=60;J({zoom_ratio:high/low});assert(high/low===3,'spotter');", "verified_output": "{\"zoom_ratio\":3}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Binoculars Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Binocular Anatomy", "Prism Types — Porro vs Roof", "Reading Binocular Numbers"], "sibling_edition": "binoculars-public-signature"}}
