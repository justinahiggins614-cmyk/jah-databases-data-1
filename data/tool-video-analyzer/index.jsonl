{"id": "JAH-TOOL-VIDEOANA-000003", "slug": "tool-video-analyzer", "title": "Video Analyzer \u2014 Core capabilities", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 5, "body": "Public edition. Public tool knowledge, fact-checked reference. Capabilities: Duration, resolution, frame-rate reporting; Scene-change detection with timestamps; Keyframe extraction per scene; Audio track transcription; Timestamped segment summaries.", "capabilities": ["Duration, resolution, frame-rate reporting", "Scene-change detection with timestamps", "Keyframe extraction per scene", "Audio track transcription", "Timestamped segment summaries"], "demo": {"language": "javascript", "title": "Core operation executed", "code": "const W=4,H=4,px=[];for(let y=0;y<H;y++)for(let x=0;x<W;x++)px.push([x*64,y*64,128]);const avg=px[0].map((_,i)=>Math.round(px.reduce((a,p)=>a+p[i],0)/px.length));J({w:W,h:H,pixels:px.length,avgColor:avg});assert(px.length===16,'image');", "verified_output": "{\"w\":4,\"h\":4,\"pixels\":16,\"avgColor\":[96,96,128]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Video Analyzer Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Image Analyzer", "Audio analysis tools", "Report Generator"], "sibling_edition": "tool-video-analyzer-signature"}}
{"id": "JAH-TOOL-VIDEOANA-000004", "slug": "tool-video-analyzer", "title": "Video Analyzer \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Analyze a 10-minute tutorial: detect 8 scenes, extract a keyframe each, transcribe the audio, and summarize per scene.", "capabilities": ["Duration, resolution, frame-rate reporting", "Scene-change detection with timestamps", "Keyframe extraction per scene", "Audio track transcription", "Timestamped segment summaries"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const data=[{day:1,errors:3},{day:2,errors:5},{day:3,errors:2}];const total=data.reduce((a,d)=>a+d.errors,0);const md='# Weekly Report\\n\\n| day | errors |\\n|---|---|\\n'+data.map(d=>`| ${d.day} | ${d.errors} |`).join('\\n')+`\\n\\nTotal errors: ${total}.`;J({total,lines:md.split('\\n').length});assert(total===10,'report');", "verified_output": "{\"total\":10,\"lines\":9}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Video Analyzer Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Image Analyzer", "Audio analysis tools", "Report Generator"], "sibling_edition": "tool-video-analyzer-signature"}}
{"id": "JAH-TOOL-VIDEOANA-000005", "slug": "tool-video-analyzer", "title": "Video Analyzer \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Processing time scales with length and resolution; transcription accuracy depends on audio quality; no speaker identification claims.", "capabilities": ["Duration, resolution, frame-rate reporting", "Scene-change detection with timestamps", "Keyframe extraction per scene", "Audio track transcription", "Timestamped segment summaries"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const BLOCKED=['weapon','attack'];function screen(p){return !BLOCKED.some(b=>p.includes(b));}const req={prompt:'a calm lake',seed:7};J({screened:screen(req.prompt),reproducible:req.seed===7});assert(screen(req.prompt),'policy');", "verified_output": "{\"screened\":true,\"reproducible\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Video Analyzer Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Image Analyzer", "Audio analysis tools", "Report Generator"], "sibling_edition": "tool-video-analyzer-signature"}}
