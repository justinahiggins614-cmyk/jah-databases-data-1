{"id": "JAH-CDB-TRANSLAT-000005", "slug": "college-translation-resource", "title": "The Translation Resource Database \u2014 Connection layer: public to Signature record mapping", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "college student database record", "ladder_rank": 9, "body": "Public edition. Real information from reliable public sources and official catalogs, fact-checked reference. The connection layer links records across both sides. Public record JAH-CDB-TRANSLAT-NNNNNN maps to Signature record JAH-CDBS-TRANSLAT-NNNNNN by shared record number; provenance is tracked per record and never mixed. The student AI searches both sides through this mapping.", "capabilities": ["Organize dictionaries and references by language pair", "Cover technical terminology per field", "Guide appropriate machine-translation use", "Distinguish academic from casual resources", "Provide field-specific term lists"], "demo": {"language": "javascript", "title": "Safety: source labeling enforced", "code": "const allowed=['public-harvest','signature-generated-completion','generated'];const src=DB.edition==='signature'?'signature-generated-completion':'public-harvest';J({src,labeled:allowed.includes(src)});assert(allowed.includes(src),'srclabel');", "verified_output": "{\"src\":\"public-harvest\",\"labeled\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-college-student-databases-101-200-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Translation Resource Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"r