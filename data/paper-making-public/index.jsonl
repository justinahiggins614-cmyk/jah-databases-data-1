{"id": "JAH-PAPERMAK-000001", "slug": "paper-making-public", "title": "History of Paper", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "paper making record", "ladder_rank": 1, "body": "Paper was invented in China around 105 AD, traditionally credited to court official Cai Lun, who made sheets from bark, rags, and fishnets. Papermaking spread west along trade routes, reaching the Islamic world by the 8th century and Europe by the 12th. Before wood pulp, paper came from linen and cotton rags — which is why old books survive so well. The Fourdrinier machine, perfected in the early 1800s, made continuous rolls of paper and slashed prices. Wood pulp replaced rags in the mid-1800s, making paper cheap enough for mass newspapers.", "capabilities": ["Give the traditional invention date of paper", "Name Cai Lun's materials", "Explain the rag-paper era", "Describe the Fourdrinier machine", "Explain the shift to wood pulp"], "demo": {"language": "javascript", "title": "Paper timeline span", "code": "const invented=105,fourdrinier=1803;J({years:fourdrinier-invented});assert(fourdrinier-invented===1698,'papertime');", "verified_output": "{\"years\":1698}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Paper Making Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Paper Fibers", "Pulping — Freeing the Fibers", "Sheet Forming — From Slurry to Sheet"], "sibling_edition": "paper-making-public-signature"}}
{"id": "JAH-PAPERMAK-000002", "slug": "paper-making-public", "title": "Paper Fibers", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "paper making record", "ladder_rank": 2, "body": "Paper is a mat of plant fibers held together by hydrogen bonds. Long softwood fibers (pine, spruce) make strong paper; short hardwood fibers (birch, eucalyptus) make smooth, opaque paper. Cotton and linen fibers are longest of all — currency and fine stationery use them. Recycled fibers are shorter and weaker but save trees and energy. Fiber length directly predicts tear strength.", "capabilities": ["Explain hydrogen bonding in paper", "Compare softwood and hardwood fibers", "Explain cotton-fiber paper uses", "Describe recycled fiber trade-offs", "Link fiber length to strength"], "demo": {"language": "javascript", "title": "Fiber length ranking", "code": "const len={cotton:25,softwood:3.5,hardwood:1.2};const longest=Object.entries(len).sort((a,b)=>b[1]-a[1])[0];J({longest:longest[0]});assert(longest[0]==='cotton','fiber');", "verified_output": "{\"longest\":\"cotton\"}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Paper Making Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["History of Paper", "Pulping — Freeing the Fibers", "Sheet Forming — From Slurry to Sheet"], "sibling_edition": "paper-making-public-signature"}}
{"id": "JAH-PAPERMAK-000003", "slug": "paper-making-public", "title": "Pulping — Freeing the Fibers", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "paper making record", "ladder_rank": 3, "body": "Pulping separates plant fibers from wood. Mechanical pulping grinds logs against stones — high yield but weak, yellowing paper like newsprint. Chemical (kraft) pulping cooks chips in chemicals that dissolve lignin, leaving strong fibers for packaging and fine papers. Semi-chemical pulping splits the difference for corrugated board. Bleaching whitens chemical pulp; unbleached kraft is the brown of grocery bags. Pulping is the most energy- and chemical-intensive step of papermaking.", "capabilities": ["Compare mechanical and kraft pulping", "Explain lignin removal", "Describe semi-chemical pulping", "Explain bleached vs unbleached kraft", "Name the costliest papermaking step"], "demo": {"language": "javascript", "title": "Pulp yield", "code": "const mech=95,kraft=50;J({mech_yield_pct:mech,kraft_yield_pct:kraft});assert(mech>kraft,'pulpyield');", "verified_output": "{\"mech_yield_pct\":95,\"kraft_yield_pct\":50}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Paper Making Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["History of Paper", "Paper Fibers", "Sheet Forming — From Slurry to Sheet"], "sibling_edition": "paper-making-public-signature"}}
{"id": "JAH-PAPERMAK-000004", "slug": "paper-making-public", "title": "Sheet Forming — From Slurry to Sheet", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "paper making record", "ladder_rank": 4, "body": "Paper forms when a dilute fiber slurry drains through a screen, leaving a fiber mat. Hand papermakers use a mould and deckle: dip, shake to interlock fibers, and couch the sheet onto felt. The Fourdrinier machine does this continuously on a moving wire mesh. Cylinder machines build thick boards by layering. Formation — how evenly fibers distribute — determines paper quality more than any other factor.", "capabilities": ["Explain the mould-and-deckle method", "Describe Fourdrinier continuous forming", "Explain cylinder machines", "Define formation quality", "Explain couching onto felt"], "demo": {"language": "javascript", "title": "Slurry consistency", "code": "const fiber=1,water=99;J({fiber_pct:fiber});assert(fiber===1,'slurry');", "verified_output": "{\"fiber_pct\":1}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Paper Making Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["History of Paper", "Paper Fibers", "Pulping — Freeing the Fibers"], "sibling_edition": "paper-making-public-signature"}}
{"id": "JAH-PAPERMAK-000005", "slug": "paper-making-public", "title": "Pressing and Drying", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "paper making record", "ladder_rank": 5, "body": "Fresh sheets are mostly water and must be pressed and dried. Pressing between felts squeezes out water mechanically — the cheapest water removal. Then heated dryer cans evaporate the rest, shrinking and strengthening the sheet. Calendering — pressing the dry sheet between polished rollers — sets smoothness and gloss. Sizing (starch or chemicals added to the sheet) controls how ink absorbs instead of feathering.", "capabilities": ["Explain mechanical pressing", "Describe dryer-can drying", "Define calendering", "Explain sizing for ink control", "Order the finishing steps"], "demo": {"language": "javascript", "title": "Water removal stages", "code": "const afterForm=80,afterPress=60,afterDry=8;J({after_press_pct:afterPress,final_pct:afterDry});assert(afterDry<afterPress,'dry');", "verified_output": "{\"after_press_pct\":60,\"final_pct\":8}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Paper Making Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["History of Paper", "Paper Fibers", "Pulping — Freeing the Fibers"], "sibling_edition": "paper-making-public-signature"}}
{"id": "JAH-PAPERMAK-000006", "slug": "paper-making-public", "title": "Paper Recycling", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "paper making record", "ladder_rank": 6, "body": "Recycling repulps used paper, screens out contaminants, de-inks it, and reforms new sheets. Each recycling shortens fibers, so paper can be recycled about 5 to 7 times before fibers are too short. De-inking uses flotation: air bubbles lift ink particles away from fibers. Recycled paper saves roughly 60 percent of the energy of virgin paper. Keep food-soiled paper and wax-coated cartons out of the recycling bin.", "capabilities": ["Describe the recycling process", "Explain the 5-to-7-times fiber limit", "Explain flotation de-inking", "Give recycled-paper energy savings", "List recycling contaminants"], "demo": {"language": "javascript", "title": "Recycle cycles", "code": "const len0=3.0,loss=0.15,cycles=6;let l=len0;for(let i=0;i<cycles;i++)l*=1-loss;J({final_mm:+l.toFixed(2)});assert(l<1.5,'recycle');", "verified_output": "{\"final_mm\":1.13}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Paper Making Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["History of Paper", "Paper Fibers", "Pulping — Freeing the Fibers"], "sibling_edition": "paper-making-public-signature"}}
{"id": "JAH-PAPERMAK-000007", "slug": "paper-making-public", "title": "Handmade Paper at Home", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "paper making record", "ladder_rank": 7, "body": "You can make paper with a blender, a picture frame with window screen, and a tub of water. Step 1: Tear scrap paper and soak it overnight. Step 2: Blend with water into pulp. Step 3: Pour pulp into the tub and stir. Step 4: Dip the screen frame, lift level, and let water drain. Step 5: Couch the sheet onto a cloth. Step 6: Press under boards, then dry flat. Add flower petals, seeds, or colored thread to the pulp for decorative sheets. Iron the dry sheet between cloths for smoothness.", "capabilities": ["List home papermaking equipment", "Give the six home papermaking steps", "Explain soaking before blending", "Describe decorative inclusions", "Explain ironing for smoothness"], "demo": {"language": "javascript", "title": "Pulp ratio", "code": "const paper_g=50,water_ml=2000;J({ratio:water_ml/paper_g});assert(water_ml/paper_g===40,'pulpratio');", "verified_output": "{\"ratio\":40}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Paper Making Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["History of Paper", "Paper Fibers", "Pulping — Freeing the Fibers"], "sibling_edition": "paper-making-public-signature"}}
{"id": "JAH-PAPERMAK-000008", "slug": "paper-making-public", "title": "Paper Types and Grades", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "paper making record", "ladder_rank": 8, "body": "Paper grades serve different jobs. Newsprint is cheap, weak, and yellows — fine for newspapers. Uncoated fine papers take ink well for books and office printing. Coated papers have a clay layer for sharp magazine images. Kraft and linerboard are strong packaging papers. Tissue, towel, and specialty papers round out the family. Basis weight (pounds per ream) measures thickness and heft.", "capabilities": ["Distinguish newsprint from fine papers", "Explain coated vs uncoated", "Describe kraft and linerboard", "Explain basis weight", "List specialty paper grades"], "demo": {"language": "javascript", "title": "Basis weight conversion", "code": "const lb_ream=50;J({lb_per_ream:lb_ream});assert(lb_ream===50,'basiswt');", "verified_output": "{\"lb_per_ream\":50}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Paper Making Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["History of Paper", "Paper Fibers", "Pulping — Freeing the Fibers"], "sibling_edition": "paper-making-public-signature"}}
