{"id": "JAH-TOOL-STEPSEQU-000001", "slug": "tool-step-sequencer", "title": "Step Sequencer \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Determines which operations must happen first, and runs them in order. The Step Sequencer takes a plan's dependency graph and determines a safe execution order: which steps can run in parallel, which must wait, and where to checkpoint. It executes the sequence, tracks each step's state, and halts with a clear report if a dependency fails.", "capabilities": ["Topological ordering of dependent steps", "Parallel execution of independent steps", "Checkpoint and resume after interruption", "Per-step state tracking", "Halt-with-report on dependency failure"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Step Sequencer\",\"capabilities\":[\"Topological ordering of dependent steps\",\"Parallel execution of independent steps\",\"Checkpoint and resume after interruption\",\"Per-step state tracking\",\"Halt-with-report on dependency failure\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Step Sequencer Librarian", "scope": "archive-aware", "assistant_maker": tru