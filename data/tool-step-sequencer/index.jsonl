{"id": "JAH-TOOL-STEPSEQU-000007", "slug": "tool-step-sequencer", "title": "Step Sequencer \u2014 Advanced pattern", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 11, "body": "Public edition. Public tool knowledge, fact-checked reference. Advanced use of Step Sequencer composes it with neighboring tools: chain its output into the next tool, add verification checkpoints, and automate the sequence once the manual path is proven.", "capabilities": ["Topological ordering of dependent steps", "Parallel execution of independent steps", "Checkpoint and resume after interruption", "Per-step state tracking", "Halt-with-report on dependency failure"], "demo": {"language": "javascript", "title": "Advanced pattern: weighted option comparison", "code": "const opts=[{n:'A',price:800,batt:10},{n:'B',price:1000,batt:16},{n:'C',price:700,batt:8}];const w={price:0.5,batt:0.5};const norm=(v,vs)=>1-(v-Math.min(...vs))/(Math.max(...vs)-Math.min(...vs)||1);const scored=opts.map(o=>({n:o.n,score:+(norm(o.price,opts.map(x=>x.price))*w.price+(o.batt/16)*w.batt).toFixed(3)})).sort((a,b)=>b.score-a.score);J({ranked:scored});assert(scored[0].n==='C','compare');", "verified_output": "{\"ranked\":[{\"n\":\"C\",\"score\":0.75},{\"n\":\"A\",\"score\":0.646},{\"n\":\"B\",\"score\":0.5}]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Step Sequencer Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Task Plann