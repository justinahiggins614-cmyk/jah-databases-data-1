{"id": "JAH-TOOL-DATABASE-000005", "slug": "tool-database-backup-restore-tool", "title": "Database Backup and Restore Tool \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Backups capture a point in time; changes after the snapshot are not included; restore targets must have capacity.", "capabilities": ["Timestamped full snapshots with manifests", "Checksum per record in the manifest", "Verified restore with count reconciliation", "Pre-restore safety snapshot", "Backup listing and pruning"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const db=new Map();function create(r){if([...db.values()].some(x=>x.key===r.key))return {error:'duplicate'};db.set(r.key,r);return {ok:true};}create({key:'k1'});const r2=create({key:'k1'});J(r2);assert(r2.error==='duplicate','unique');", "verified_output": "{\"error\":\"duplicate\"}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Database Backup and Restore Tool Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["File Copy Tool", "Record Validator", "Audit Logger"], "sibling_edition": "tool-database-backup-restore-tool-signature"}}
