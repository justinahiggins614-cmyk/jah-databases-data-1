{"id": "JAH-SIG-CONDITIO-000002", "slug": "tool-condition-checker-signature", "title": "Condition Checker \u2014 Input and output contract", "edition": "signature", "src": "signature-generated-completion", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Signature edition. Original Signature methods and framings developed for the JAH system, labeled Signature throughout. Inputs: Condition expression, current facts/context. Outputs: Pass/fail verdict with the evidence examined.", "capabilities": ["Boolean, comparison, and range conditions", "Compound AND/OR/NOT logic", "Evidence attached to every verdict", "Pre-action gating for other tools", "Condition libraries for reuse"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const task={goal:'publish report',constraints:['by Friday'],done:'PDF delivered'};const ok=task.goal&&task.done;J({valid:!!ok});assert(ok,'contract');", "verified_output": "{\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Condition Checker Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Rule Engine", "Result Verification Tool", "Permission Manager"], "sibling_edition": "tool-condition-checker"}}
{"id": "JAH-SIG-CONDITIO-000003", "slug": "tool-condition-checker-signature", "title": "Condition Checker \u2014 Core capabilities", "edition": "signature", "src": "signature-generated-completion", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 5, "body": "Signature edition. Original Signature methods and framings developed for the JAH system, labeled Signature throughout. Capabilities: Boolean, comparison, and range conditions; Compound AND/OR/NOT logic; Evidence attached to every verdict; Pre-action gating for other tools; Condition libraries for reuse.", "capabilities": ["Boolean, comparison, and range conditions", "Compound AND/OR/NOT logic", "Evidence attached to every verdict", "Pre-action gating for other tools", "Condition libraries for reuse"], "demo": {"language": "javascript", "title": "Core operation executed", "code": "const steps=[{id:'a',deps:[]},{id:'b',deps:['a']},{id:'c',deps:['a']},{id:'d',deps:['b','c']}];const done=new Set(),order=[];while(order.length<steps.length){const nxt=steps.find(s=>!done.has(s.id)&&s.deps.every(d=>done.has(d)));if(!nxt)throw new Error('cycle');done.add(nxt.id);order.push(nxt.id);}J({order});assert(order[0]==='a'&&order[3]==='d','topo');", "verified_output": "{\"order\":[\"a\",\"b\",\"c\",\"d\"]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Condition Checker Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Rule Engine", "Result Verification Tool", "Permission Manager"], "sib