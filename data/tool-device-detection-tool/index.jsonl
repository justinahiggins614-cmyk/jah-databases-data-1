{"id": "JAH-TOOL-DEVICEDE-000002", "slug": "tool-device-detection-tool", "title": "Device Detection Tool \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Device class filter (optional), detail level. Outputs: Device inventory: identity, class, status, properties.", "capabilities": ["Enumerate storage drives with capacity and free space", "List displays with resolution and position", "Detect printers and their status", "Identify audio input/output devices", "Watch for device connect/disconnect events"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const ev={type:'click',target:{x:120,y:80}};const ok=ev.type&&ev.target&&typeof ev.target.x==='number';J({event:ev.type,valid:!!ok});assert(ok,'contract');", "verified_output": "{\"event\":\"click\",\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Device Detection Tool Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["System Information Tool", "Storage Monitor", "File Writer"], "sibling_edition": "tool-device-detection-tool-signature"}}
