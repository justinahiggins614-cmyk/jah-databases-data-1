{"id": "JAH-TOOL-DEVICEDE-000001", "slug": "tool-device-detection-tool", "title": "Device Detection Tool \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Identifies connected drives, displays, printers, and supported peripherals. The Device Detection Tool enumerates the hardware attached to the system: storage drives with capacity, displays with resolution, printers, audio devices, and other supported peripherals. It reports each device's identity, status, and key properties so other tools can address the right hardware.", "capabilities": ["Enumerate storage drives with capacity and free space", "List displays with resolution and position", "Detect printers and their status", "Identify audio input/output devices", "Watch for device connect/disconnect events"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Device Detection Tool\",\"capabilities\":[\"Enumerate storage drives with capacity and free space\",\"List displays with resolution and position\",\"Detect printers and their status\",\"Identify audio input/output devices\",\"Watch for device connect/disconnect events\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete":