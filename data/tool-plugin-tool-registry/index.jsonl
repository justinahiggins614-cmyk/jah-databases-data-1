{"id": "JAH-TOOL-PLUGINTO-000004", "slug": "tool-plugin-tool-registry", "title": "Plugin and Tool Registry \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Register a new summarizer tool with its input schema and permission needs, then search the registry for 'tools that read PDFs'.", "capabilities": ["Tool capability catalog with schemas", "Permission and requirement per tool", "Version tracking per tool", "Capability-based tool search", "Registration-time validation"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const data=[{day:1,errors:3},{day:2,errors:5},{day:3,errors:2}];const total=data.reduce((a,d)=>a+d.errors,0);const md='# Weekly Report\\n\\n| day | errors |\\n|---|---|\\n'+data.map(d=>`| ${d.day} | ${d.errors} |`).join('\\n')+`\\n\\nTotal errors: ${total}.`;J({total,lines:md.split('\\n').length});assert(total===10,'report');", "verified_output": "{\"total\":10,\"lines\":9}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Plugin and Tool Registry Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["AI Coordinator", "Knowledge Base Manager", "Workflow Engine"], "sibling_edition": "tool-plugin-tool-registry-signature"}}
{"id": "JAH-TOOL-PLUGINTO-000005", "slug": "tool-plugin-tool-registry", "title": "Plugin and Tool Registry \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Lists what is registered \u2014 unregistered tools are invisible; entries must be validated so the catalog never promises what is not installed.", "capabilities": ["Tool capability catalog with schemas", "Permission and requirement per tool", "Version tracking per tool", "Capability-based tool search", "Registration-time validation"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const BLOCKED=['weapon','attack'];function screen(p){return !BLOCKED.some(b=>p.includes(b));}const req={prompt:'a calm lake',seed:7};J({screened:screen(req.prompt),reproducible:req.seed===7});assert(screen(req.prompt),'policy');", "verified_output": "{\"screened\":true,\"reproducible\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Plugin and Tool Registry Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["AI Coordinator", "Knowledge Base Manager", "Workflow Engine"], "sibling_edition": "tool-plugin-tool-registry-signature"}}
{"id": "JAH-TOOL-PLUGINTO-000006", "slug": "tool-plugin-tool-registry", "title": "Plugin and Tool Registry \u2014 Beginner teaching exercise", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 2, "body": "Public edition. Public tool knowledge, fact-checked reference. Start simple: identify the tool's single core action for Plugin and Tool Registry, run it once on a tiny input, and verify the output matches expectations before scaling up.", "capabilities": ["Tool capability catalog with schemas", "Permission and requirement per tool", "Version tracking per tool", "Capability-based tool search", "Registration-time validation"], "demo": {"language": "javascript", "title": "Teaching exercise: beginner", "code": "const reg=new Map();reg.set('summarizer',{inputs:['text'],needs:['none']});const found=[...reg.entries()].filter(([n,t])=>t.inputs.includes('text')).map(([n])=>n);J({found});assert(found[0]==='summarizer','registry');", "verified_output": "{\"found\":[\"summarizer\"]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Plugin and Tool Registry Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["AI Coordinator", "Knowledge Base Manager", "Workflow Engine"], "sibling_edition": "tool-plugin-tool-registry-signature"}}
{"id": "JAH-TOOL-PLUGINTO-000007", "slug": "tool-plugin-tool-registry", "title": "Plugin and Tool Registry \u2014 Advanced pattern", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 11, "body": "Public edition. Public tool knowledge, fact-checked reference. Advanced use of Plugin and Tool Registry composes it with neighboring tools: chain its output into the next tool, add verification checkpoints, and automate the sequence once the manual path is proven.", "capabilities": ["Tool capability catalog with schemas", "Permission and requirement per tool", "Version tracking per tool", "Capability-based tool search", "Registration-time validation"], "demo": {"language": "javascript", "title": "Advanced pattern: coordinator plan", "code": "const plan=[{tool:'reader',in:'doc.pdf'},{tool:'summarizer',in:'reader.out'},{tool:'mailer',in:'summarizer.out'}];const order=plan.map((s,i)=>`${i+1}.${s.tool}`).join(' -> ');J({order,steps:plan.length});assert(plan.length===3,'plan');", "verified_output": "{\"order\":\"1.reader -> 2.summarizer -> 3.mailer\",\"steps\":3}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Plugin and Tool Registry Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["AI Coordinator", "Knowledge Base Manager", "Workflow Engine"], "sibling_edition": "tool-plugin-tool-registry-signature"}}
