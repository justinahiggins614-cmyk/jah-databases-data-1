{"id": "JAH-CTOOL-STUDENTB-000001", "slug": "college-tool-student-budget-planner", "title": "Student Budget Planner \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Creates budgets based on income, aid, and real student expenses. The Student Budget Planner creates budgets based on income and expenses. It takes the student's monthly income \u2014 job, aid, family support \u2014 and their real expenses \u2014 rent, food, transport, books \u2014 and builds a balanced monthly budget with a small emergency cushion. Spending categories get caps, and the plan shows exactly where every dollar goes.", "capabilities": ["Build monthly budgets from income and expenses", "Set spending caps per category", "Include an emergency cushion", "Show where every dollar goes", "Adjust when income or costs change"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Student Budget Planner\",\"capabilities\":[\"Build monthly budgets from income and expenses\",\"Set spending caps per category\",\"Include an emergency cushion\",\"Show where every dollar goes\",\"Adjust when income or costs change\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-college-student-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete":