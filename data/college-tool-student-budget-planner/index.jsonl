{"id": "JAH-CTOOL-STUDENTB-000004", "slug": "college-tool-student-budget-planner", "title": "Student Budget Planner \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. $1,800 income: $700 rent, $300 food, $150 transport, $100 books, $200 savings cushion, $350 flexible.", "capabilities": ["Build monthly budgets from income and expenses", "Set spending caps per category", "Include an emergency cushion", "Show where every dollar goes", "Adjust when income or costs change"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const P=27000,annual=0.055,n=120;const r=annual/12;const M=P*r/(1-Math.pow(1+r,-n));const total=M*n;const interest=total-P;J({monthly:+M.toFixed(2),totalInterest:+interest.toFixed(0)});assert(M>290&&M<296&&interest>8000,'loan');", "verified_output": "{\"monthly\":293.02,\"totalInterest\":8163}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-college-student-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Student Budget Planner Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Expense Tracker", "Scholarship Finder", "Financial Aid Organizer"], "sibling_edition": "college-tool-student-budget-planner-signature"}}
{"id": "JAH-CTOOL-STUDENTB-000005", "slug": "college-tool-student-budget-planner", "title": "Student Budget Planner \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Budgets the money the student actually has; cannot create income; the student must track spending against it.", "capabilities": ["Build monthly budgets from income and expenses", "Set spending caps per category", "Include an emergency cushion", "Show where every dollar goes", "Adjust when income or costs change"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const cap=100,spent=140;const over=spent>cap;const inventedIncome=0;J({cap,spent,overCap:over,inventedIncome});assert(over===true&&inventedIncome===0,'cap');", "verified_output": "{\"cap\":100,\"spent\":140,\"overCap\":true,\"inventedIncome\":0}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-college-student-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Student Budget Planner Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Expense Tracker", "Scholarship Finder", "Financial Aid Organizer"], "sibling_edition": "college-tool-student-budget-planner-signature"}}
