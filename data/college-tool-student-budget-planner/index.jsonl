{"id": "JAH-CTOOL-STUDENTB-000002", "slug": "college-tool-student-budget-planner", "title": "Student Budget Planner \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Monthly income sources, expense list. Outputs: Balanced budget with category caps.", "capabilities": ["Build monthly budgets from income and expenses", "Set spending caps per category", "Include an emergency cushion", "Show where every dollar goes", "Adjust when income or costs change"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const req=['amount','category','date'];const e={amount:12.5,category:'food',date:'2026-10-21'};const missing=req.filter(k=>!(k in e));J({contract:'expense',missing});assert(missing.length===0,'contract');", "verified_output": "{\"contract\":\"expense\",\"missing\":[]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-college-student-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Student Budget Planner Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Expense Tracker", "Scholarship Finder", "Financial Aid Organizer"], "sibling_edition": "college-tool-student-budget-planner-signature"}}
