{"id": "JAH-BUILD-000001", "slug": "tool-builds-public", "title": "Build a Ladder-Back Chair", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool build record", "ladder_rank": 2, "body": "A ladder-back chair has two rear posts, horizontal slats, and a woven or wooden seat. Step 1: Cut two rear posts 42 inches long and two front legs 18 inches, all from 2x2 hardwood. Step 2: Cut three slats 18 inches long and two side stretchers. Step 3: Drill mortises in the posts and tenons on the slats. Step 4: Glue the back assembly first, then join the front legs with side stretchers. Step 5: Fit the seat — wood, rush, or woven cord. Step 6: Sand everything to 220 grit and finish with oil or polyurethane. Let glue cure 24 hours before sitting.", "capabilities": ["List the parts of a ladder-back chair", "Give the cut list for the chair", "Explain the assembly order", "Describe seat options", "Explain glue curing time"], "demo": {"language": "javascript", "title": "Cut-list total", "code": "const parts=[42,42,18,18,18,18,18,16,16];const total=parts.reduce((a,b)=>a+b,0);J({parts:parts.length,total_in:total});assert(total===206,'cutlist');", "verified_output": "{\"parts\":9,\"total_in\":206}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt (items 129-131) + field-audit fill", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 12, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Tool Builds Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Build a Windsor Chair", "Build a Folding Chair", "Build a Farmhouse Table"], "sibling_edition": "t