{"id": "JAH-TOOL-RULEENGI-000001", "slug": "tool-rule-engine", "title": "Rule Engine \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Applies explicit rules to inputs and decisions, transparently. The Rule Engine evaluates explicit if-then rules against facts: when conditions match, the rule fires its action or conclusion. Rules are readable, ordered by priority, and every decision lists which rules fired and why. It is the transparent alternative to black-box judgment for policy-like decisions.", "capabilities": ["If-then rule evaluation over facts", "Priority ordering and conflict resolution", "Fired-rule trace per decision", "Rule validation (overlap, contradiction)", "Batch fact processing"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Rule Engine\",\"capabilities\":[\"If-then rule evaluation over facts\",\"Priority ordering and conflict resolution\",\"Fired-rule trace per decision\",\"Rule validation (overlap, contradiction)\",\"Batch fact processing\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-basic-pc-ai-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Rule Engine Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {