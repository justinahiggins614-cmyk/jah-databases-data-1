{"id": "JAH-TOOL-UNCERTAI-000004", "slug": "tool-uncertainty-estimation-engine", "title": "Uncertainty Estimation Engine \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Score a 5-claim briefing: 3 well-supported, 1 thin, 1 conflicting \u2014 and mark the thin one 'do not decide on this alone'.", "capabilities": ["Per-claim confidence scoring", "Evidence-sufficiency flagging", "Known-vs-assumed separation", "Conflicting-evidence detection", "Risk-weighted summary for decisions"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const claims=[{c:'motor ok',ev:5},{c:'sensor ok',ev:2},{c:'link ok',ev:0}];const conf=claims.map(x=>({claim:x.c,conf:x.ev>=4?'high':x.ev>=2?'medium':'insufficient - do not decide'}));J({conf});assert(conf[2].conf.includes('insufficient'),'uncertainty');", "verified_output": "{\"conf\":[{\"claim\":\"motor ok\",\"conf\":\"high\"},{\"claim\":\"sensor ok\",\"conf\":\"medium\"},{\"claim\":\"link ok\",\"conf\":\"insufficient - do not decide\"}]}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Uncertainty Estimation Engine Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Competing Hypothesis Analyzer", "Result Verification Tool", "Decision Support Engine"], "sibling_edition": "tool-uncertainty-estimation-engine-signature"}}
