{"id": "JAH-TOOL-HETEROGE-000001", "slug": "tool-heterogeneous-compute-scheduler", "title": "Heterogeneous Compute Scheduler \u2014 Overview and definition", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 1, "body": "Public edition. Public tool knowledge, fact-checked reference. Allocates work across CPUs, GPUs, accelerators, and other supported processors. The Heterogeneous Compute Scheduler assigns computational tasks to the right processor type: CPU for sequential logic, GPU for parallel math, accelerators for specialized ops. It models each task's affinity, each device's capacity, and produces a schedule minimizing total completion time under device limits. A scheduling algorithm for compute planning. Capability specification and design target: this database describes what the tool must do, not a claim of implementation or deployment. Defensive and engineering content only \u2014 no weapon-targeting or attack-execution content.", "capabilities": ["Task-to-device affinity modeling", "Capacity-constrained scheduling", "Makespan minimization", "Device-utilization reporting", "What-if device-count scenarios"], "demo": {"language": "javascript", "title": "Tool overview and capability inventory", "code": "J({tool:TOOL.name,capabilities:TOOL.capabilities,count:TOOL.capabilities.length});assert(TOOL.capabilities.length>=5,'caps');", "verified_output": "{\"tool\":\"Heterogeneous Compute Scheduler\",\"capabilities\":[\"Task-to-device affinity modeling\",\"Capacity-constrained scheduling\",\"Makespan minimization\",\"Device-utilization reporting\",\"What-if device-count scenarios\"],\"count\":5}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "