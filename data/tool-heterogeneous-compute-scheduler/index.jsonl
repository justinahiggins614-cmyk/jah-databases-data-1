{"id": "JAH-TOOL-HETEROGE-000002", "slug": "tool-heterogeneous-compute-scheduler", "title": "Heterogeneous Compute Scheduler \u2014 Input and output contract", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 3, "body": "Public edition. Public tool knowledge, fact-checked reference. Inputs: Tasks with affinities, device inventory with capacities. Outputs: Assignment schedule with makespan and utilization.", "capabilities": ["Task-to-device affinity modeling", "Capacity-constrained scheduling", "Makespan minimization", "Device-utilization reporting", "What-if device-count scenarios"], "demo": {"language": "javascript", "title": "Input/output contract validation", "code": "const task={name:'train',affinity:'gpu',mem:8};const ok=['cpu','gpu'].includes(task.affinity);J({valid:!!ok});assert(ok,'contract');", "verified_output": "{\"valid\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Heterogeneous Compute Scheduler Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Distributed AI Inference Engine", "Compute Capacity Optimizer", "Parallel Data Processing Engine"], "sibling_edition": "tool-heterogeneous-compute-scheduler-signature"}}
