{"id": "JAH-TOOL-HETEROGE-000004", "slug": "tool-heterogeneous-compute-scheduler", "title": "Heterogeneous Compute Scheduler \u2014 Worked example", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 7, "body": "Public edition. Public tool knowledge, fact-checked reference. Schedule 12 tasks over 2 CPUs and 1 GPU: GPU-bound tasks to the GPU, makespan 47 s, utilization 91%.", "capabilities": ["Task-to-device affinity modeling", "Capacity-constrained scheduling", "Makespan minimization", "Device-utilization reporting", "What-if device-count scenarios"], "demo": {"language": "javascript", "title": "Worked example end to end", "code": "const jobs=[{n:'a',cpu:4},{n:'b',cpu:8},{n:'c',cpu:2}];const cap=10;let bins=0,load=0;const sorted=[...jobs].sort((x,y)=>y.cpu-x.cpu);sorted.forEach(j=>{if(load+j.cpu>cap){bins++;load=0;}load+=j.cpu;});bins++;J({bins,lastLoad:load});assert(bins===2,'binpack');", "verified_output": "{\"bins\":2,\"lastLoad\":6}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Heterogeneous Compute Scheduler Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Distributed AI Inference Engine", "Compute Capacity Optimizer", "Parallel Data Processing Engine"], "sibling_edition": "tool-heterogeneous-compute-scheduler-signature"}}
{"id": "JAH-TOOL-HETEROGE-000005", "slug": "tool-heterogeneous-compute-scheduler", "title": "Heterogeneous Compute Scheduler \u2014 Safety, limits, and failure modes", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "tool database record", "ladder_rank": 9, "body": "Public edition. Public tool knowledge, fact-checked reference. Model-based planning; real schedulers need runtime feedback; affinity estimates must come from profiling, not guesses. Capability specification and design target: this database describes what the tool must do, not a claim of implementation or deployment. Defensive and engineering content only \u2014 no weapon-targeting or attack-execution content.", "capabilities": ["Task-to-device affinity modeling", "Capacity-constrained scheduling", "Makespan minimization", "Device-utilization reporting", "What-if device-count scenarios"], "demo": {"language": "javascript", "title": "Safety limits enforced", "code": "const tiers={hot:2,warm:4};const items=['a','b','c','d','e','f','g'];const hot=items.slice(0,tiers.hot),warm=items.slice(tiers.hot,tiers.hot+tiers.warm),cold=items.slice(tiers.hot+tiers.warm);J({hot:warm.length,cold:cold.length,retrievable:hot.concat(warm,cold).length===7});assert(cold.length===1,'tiers');", "verified_output": "{\"hot\":4,\"cold\":1,\"retrievable\":true}", "verified_at": "2026-10-21", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "catalog-100-darpa-nasa-grade-tools-2026-10-21.txt", "last_verified": "2026-10-21", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true}, "ai": {"name": "JAH Heterogeneous Compute Scheduler Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"re