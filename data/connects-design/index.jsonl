{"id": "JAH-CONN-000008", "slug": "connects-design", "title": "Connects Design — Connects Connector Hub Geometry", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure design record", "ladder_rank": 15, "body": "Public edition. Public build reference. Understanding hubs is the key to connector toys: each hub has slots at fixed angles, and rods only lock at those angles. Method: (1) count the slots on your hub type; (2) note which slots are straight-through vs angled; (3) plan builds from the angles the hub actually offers; (4) never force a rod into a wrong-angle slot — it will pop under load. Tip: when a design will not close, the hub angle is wrong, not the rod length.", "capabilities": ["Count hub slots", "Map straight vs angled slots", "Plan from real hub angles", "Never force wrong angles", "Diagnose closure failures"], "demo": {"language": "javascript", "title": "Connects hub angle lister", "code": "const a=[];for(let i=0;i<C.slots;i++)a.push(i*45);assert(a.length===C.expected_angles,'angles');J({slot_angles_deg:a});", "verified_output": "{\"slot_angles_deg\":[0,45,90,135,180,225,270,315]}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Connects Design Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Connects Cube Frame", "Connects Pyramid", "Connects Bridge Truss"], "sibling_edition": "connects-design-signature"}}
