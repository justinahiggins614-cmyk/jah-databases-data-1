{"id": "JAH-CONN-000005", "slug": "connects-design", "title": "Connects Design — Connects Tower", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure design record", "ladder_rank": 8, "body": "Public edition. Public build reference. A tall braced tower. Materials: 40 rods, 20 hubs. Steps: (1) build a square base; (2) add levels, alternating the diagonal direction each level; (3) taper: drop one rod length every 3 levels; (4) cap with a hub and flag rod. Tip: alternating diagonals stop the twist that collapses tall towers.", "capabilities": ["Build the square base", "Alternate diagonals per level", "Taper every three levels", "Cap the tower", "Check for twist"], "demo": {"language": "javascript", "title": "Connects tower level planner", "code": "const n=C.levels*C.rods_per_level;assert(n===C.expected,'rods');J({rods_needed:n});", "verified_output": "{\"rods_needed\":36}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Connects Design Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Connects Cube Frame", "Connects Pyramid", "Connects Bridge Truss"], "sibling_edition": "connects-design-signature"}}
