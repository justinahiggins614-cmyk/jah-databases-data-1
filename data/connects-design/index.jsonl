{"id": "JAH-CONN-000001", "slug": "connects-design", "title": "Connects Design — Connects Cube Frame", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure design record", "ladder_rank": 1, "body": "Public edition. Public build reference for connector toys (rods + connector hubs, e.g., K'NEX-style builds). A rigid cube frame. Materials: 12 rods (same length), 8 eight-way connector hubs. Steps: (1) press 3 rods into each of 4 hubs to make two squares; (2) join the squares with 4 vertical rods; (3) seat the top 4 hubs; (4) twist-check every joint — each rod must click fully into its hub slot. Tip: same-length rods and full seating are what make the cube rigid instead of wobbly.", "capabilities": ["Make the base squares", "Join squares with verticals", "Seat the top hubs", "Twist-check every joint", "Verify rigidity"], "demo": {"language": "javascript", "title": "Connects cube parts counter", "code": "const n=C.rods+C.hubs;assert(n===C.expected_parts,'parts');J({total_parts:n});", "verified_output": "{\"total_parts\":20}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Connects Design Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Connects Pyramid", "Connects Bridge Truss"], "sibling_edition": "connects-design-signature"}}
{"id": "JAH-CONN-000002", "slug": "connects-design", "title": "Connects Design — Connects Pyramid", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure design record", "ladder_rank": 2, "body": "Public edition. Public build reference. A square pyramid. Materials: 8 rods, 5 hubs (4 base + 1 apex). Steps: (1) build the square base with 4 rods and 4 hubs; (2) press one rod into each base hub, angling up; (3) gather the 4 rods into the apex hub; (4) check the apex is centered — measure base corners to apex. Tip: the pyramid is strong because every face is a triangle.", "capabilities": ["Build the square base", "Angle the four risers", "Gather rods at the apex", "Center the apex", "Verify triangular faces"], "demo": {"language": "javascript", "title": "Connects pyramid parts counter", "code": "const n=C.base_rods+C.risers+C.hubs;assert(n===C.expected,'parts');J({total_parts:n});", "verified_output": "{\"total_parts\":13}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Connects Design Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Connects Cube Frame", "Connects Bridge Truss"], "sibling_edition": "connects-design-signature"}}
{"id": "JAH-CONN-000003", "slug": "connects-design", "title": "Connects Design — Connects Bridge Truss", "edition": "public", "src": "public-harvest", "built_by": "assistant-built", "record_kind": "structure design record", "ladder_rank": 4, "body": "Public edition. Public build reference. A truss bridge span. Materials: 30 rods (2 lengths), 16 hubs. Steps: (1) build two side trusses: bottom chord, top chord, and diagonal zigzag between; (2) connect the trusses with cross rods top and bottom; (3) seat the deck rods; (4) load-test with books at midspan. Tip: the diagonals must zigzag — all diagonals leaning one way lets the truss rack sideways.", "capabilities": ["Build the side trusses", "Zigzag the diagonals", "Cross-connect the trusses", "Seat the deck", "Load-test midspan"], "demo": {"language": "javascript", "title": "Connects truss diagonal counter", "code": "const n=C.panels*C.per_panel;assert(n===C.expected,'diagonals');J({diagonals:n});", "verified_output": "{\"diagonals\":10}", "verified_at": "2026-10-22", "node": "v24.20.0", "run": "node"}, "provenance": {"source_paste": "manons-orders-2026-10-20-database-batch.txt items 137-145", "last_verified": "2026-10-22", "origin": "assistant-built"}, "million_march": {"target": 1000000, "records_now": 8, "status": "march-in-progress", "marker": "march to a million: in progress"}, "generator": {"hard_cap": 1000000000000000, "ladder": ["simple", "competitive", "mix-and-match", "unmade", "top-notch-or-better", "future-grade", "god-mode"], "self_regulation": true, "stop_when_complete": true, "throttled": true}, "ai": {"name": "JAH Connects Design Librarian", "scope": "archive-aware", "assistant_maker": true}, "links": {"related": ["Connects Cube Frame", "Connects Pyramid"], "sibling_edition": "connects-design-signature"}}
